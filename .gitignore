.venv/
.uv-cache/
.pytest_cache/
__pycache__/
*.py[cod]

# Simulation runs stay on disk only; the catalog and README are tracked.
results/**
!results/README.md
!results/catalog/
!results/catalog/**

# Scratch layout work directory
analog/layout/work/

# Heavy layout & PnR binary/generated deliverables stay on local disk (distributed via GitHub Releases
# or regenerated by the tracked Python generators in analog/**/layout/ and digital/pnr/).
*.gds
*.def
*_pg.v
*.mag
*.spef
*.sdf
*.guide
*.fsdb
*.fsdb.*

# Vector duplicates (~130 MB) stay on disk only; PNG twins are tracked.
docs/figures/**/*.svg
docs/schematics/svg/**/*.svg

# Release tarball duplicates the tracked release directory.
releases/*.tar.gz
.history_sta

# Raw layout extraction, simulator logs, and root waveforms belong in append-only results/.
/analog/**/layout/**/*.log
/analog/**/layout/**/*.ext
/analog/**/layout/**/*.sim
/analog/**/layout/**/*.nodes
/digital/**/layout/**/*.log
/digital/**/layout/**/*.ext
/*.vcd
/*.raw
/*.fst
bsim4v5.out

# VCS / Verdi / simulator build scratch
simv
simv.daidir/
csrc/
ucli.key
verdiLog/
novas.conf
novas.rc
novas_dump.log
DVEfiles/
