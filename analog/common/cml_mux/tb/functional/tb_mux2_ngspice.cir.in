2:1 CML selector at 4 Gb/s output, ideal correlated input/select sources
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/cml_mux/spice/cml_mux2.spice"
.param supply=1.8 iref=0.85m data_cm=1.65 data_half=0.1 select_cm=1.63 select_half=0.1
.param wdata=20 wselect=64 wtail=12 rload=400 wsf=40 wsf_sink=4 cload=20f
Vdd vdd 0 {supply}
Iref vdd vbias {iref}
Xbias vbias vbias 0 0 serdes_nfet w=20 l=0.5 nf=4
* Sources are supplied by a deterministic fixture; not a verified clock distribution network.
.include "stimuli.inc"
Xdut ap an bp bn sp sn qp qn vbias vdd 0 serdes_cml_mux2
+ wdata={wdata} wselect={wselect} wtail={wtail} rload={rload} wsf={wsf} wsf_sink={wsf_sink}
Cqp qp 0 {cload}
Cqn qn 0 {cload}
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(qp) v(qn) v(ap) v(an) v(bp) v(bn) v(sp) v(sn) v(vdd) i(Vdd)
.control
set wr_singlescale
set wr_vecnames
tran 2p 40n 0 2p
let dout=v(qp)-v(qn)
let da=v(ap)-v(an)
let db=v(bp)-v(bn)
let ds=v(sp)-v(sn)
let cmout=(v(qp)+v(qn))/2
let power=-v(vdd)*i(Vdd)
wrdata waveforms.tsv dout da db ds cmout power
quit
.endc
.end
