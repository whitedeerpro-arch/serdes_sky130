Full-rate 2 GHz CML-to-CMOS clock receiver behind a real extraction buffer
* Same input boundary as the r3 prescaler PVT grid: 300 mVpp differential sine,
* CM = VDD - 0.15 V, into the frontend CML buffer, which also drives a real r3
* prescaler (its normal neighbour). Receiver cell and sizes are placeholders.
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_pfet_lvt.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos.spice"
.include "@PROJECT_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos_pvt_candidate.spice"
@EXTRA_INCLUDE@
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_div2.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_prescaler8.spice"
.param supply=@SUPPLY@ input_pp=@INPUT_PP@
Vdd vdd 0 {supply}
Vrx vrx 0 {supply}
Vreference vref 0 {supply}
Iref vref vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
Vp sp 0 SIN({supply-.15} {input_pp/4} 2e9)
Vn sn 0 SIN({supply-.15} {-input_pp/4} 2e9)
Xbuf sp sn bp bn vbias vdd 0 serdes_cml_buffer
Xpre bp bn d2p d2n d4p d4n d8p d8n vbias vdd 0 pll_cml_prescaler8
Xrx bp bn outp outn vbias vrx 0 @RX_CELL@ @RX_PARAMS@
Cop outp 0 20f
Con outn 0 20f
@NODESET@
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
.control
set num_threads=1
set wr_singlescale
set wr_vecnames
tran 2p @STOP@ 0 2p
let din=v(bp)-v(bn)
let cmin=(v(bp)+v(bn))/2
let prx=-v(vrx)*i(Vrx)
wrdata waveforms.tsv din cmin v(outp) v(outn) prx @PROBES@
quit
.endc
.end
