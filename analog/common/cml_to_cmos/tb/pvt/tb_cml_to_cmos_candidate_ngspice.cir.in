SKY130 DC-coupled differential CML-to-CMOS converter
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos.spice"
.include "@PROJECT_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos_pvt_candidate.spice"
.include "@PROJECT_ROOT@/verification/stimuli/spice/cml_diff_sine.spice"

.param supply=@SUPPLY@ freq=@FREQ_HZ@ vcm=@INPUT_CM@ vdiff_pp=@DIFF_PP@
.param cload=20f rsource=1 iref=0.85m
.param wsf=20 wsf_sink=2 win=6 wload=8 wtail=8
.param pre_wn=1.8 pre_wp=3.6 out_wn=4 out_wp=8
Vdd vdd 0 {supply}
* Independent accounting of the ideal reference branch.
Vref_supply ref_supply 0 {supply}
Iref ref_supply vbias {iref}
Xbias vbias vbias 0 0 serdes_nfet w=20 l=0.5 nf=4
Xstim sourcep sourcen 0 stim_cml_diff_sine vcm={vcm} vdiff_pp={vdiff_pp} freq={freq}
Rp sourcep sensep {rsource}
Rn sourcen sensen {rsource}
Vinp sensep inp 0
Vinn sensen inn 0
Xrx inp inn outp outn vbias vdd 0 serdes_cml_to_cmos_pvt_candidate
+ wsf={wsf} wsf_sink={wsf_sink} win={win} wload={wload} wtail={wtail}
+ pre_wn={pre_wn} pre_wp={pre_wp} out_wn={out_wn} out_wp={out_wp}
Cop outp 0 {cload}
Con outn 0 {cload}
.nodeset v(xrx.xrestore.qp)=0 v(xrx.xrestore.qn)={supply}
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
.control
set num_threads=1
set wr_singlescale
set wr_vecnames
tran 2p @STOP@ 0 2p
let din=v(inp)-v(inn)
let power=-v(vdd)*i(Vdd)
wrdata waveforms.tsv din v(inp) v(inn) v(outp) v(outn) power i(Vinp) i(Vinn) v(xrx.fp) v(xrx.fn) v(xrx.ap) v(xrx.an) v(xrx.bp) v(xrx.bn) v(xrx.rawp) v(xrx.rawn) v(xrx.xap.tail) v(xrx.xap.mirror) v(vbias)
wrdata restorer.tsv v(xrx.rawp) v(xrx.rawn) v(xrx.xrestore.set_b) v(xrx.xrestore.reset_b) v(xrx.xrestore.qp) v(xrx.xrestore.qn)
quit
.endc
.end
