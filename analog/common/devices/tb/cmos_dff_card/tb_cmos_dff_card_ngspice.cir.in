CMOS DFF timing card: clk->q, setup / hold aperture, inverter delay
* Unit sources (0..1 V) scaled by v(vdd) so one deck serves every supply (alter Vdd).
* Clock and data each pass two inverters (wn=2/wp=4, wn=4/wp=8) to get realistic slews; offsets
* are measured at the DUT pins.  The DUT drives a second DFF's D input on the same clock (shift
* register load) plus 2 fF.
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff.spice"
Vdd vdd 0 @SUPPLY@
Vcku cku 0 PULSE(0 1 @CLK_DELAY@ 30p 30p @CLK_HIGH@ @CLK_PERIOD@)
Vdu du 0 PWL(@DATA_PWL@)
Bck ck0 0 V=v(vdd)*v(cku)
Bd d0 0 V=v(vdd)*v(du)
Vrstu rstu 0 PWL(0 0 0.3n 0 0.32n 1)
Brst rst_b 0 V=v(vdd)*v(rstu)
Xc1 ck0 ck1 vdd 0 serdes_cmos_inv wn=2 wp=4
Xc2 ck1 clk vdd 0 serdes_cmos_inv wn=4 wp=8
Xd1 d0 d1 vdd 0 serdes_cmos_inv wn=2 wp=4
Xd2 d1 d vdd 0 serdes_cmos_inv wn=4 wp=8
@CELLS@
Cq q 0 2f
Cq2 q2 0 2f
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(ck0) v(clk) v(d) v(q) v(vdd)
.control
set filetype=binary
@CASES@
quit
.endc
.end
