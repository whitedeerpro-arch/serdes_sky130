SKY130 steering CP (pll_cp_steer, k = 4 sizes) DC source/sink versus output voltage
* As tb_cp_dc_ngspice.cir.in with the current-steering CP of pll_core_r5k4: base 50 uA diodes, x4 output devices
* (200 uA), follower tail from a 10 uA bias copy (ibias; window_steer.py wires it to the real reference).
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_pfet_lvt.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/pll/cp/spice/charge_pump.spice"
.include "@PROJECT_ROOT@/analog/pll/cp/spice/charge_pump_steer.spice"
.param supply=1.8 irefn=50u irefp=50u
Vdd vdd 0 {supply}
Vbias vb 0 {supply}
In vb vbn {irefn}
Ip vbp 0 {irefp}
Xbn vbn vbn 0 0 serdes_nfet w=5 l=1
Xbp vbp vbp vb vb serdes_pfet w=20 l=1 nf=4
Xup vdd 0 ou vbn vbp ibu vdd 0 pll_cp_steer @CP_PARAMS@
Xdn 0 vdd od vbn vbp ibd vdd 0 pll_cp_steer @CP_PARAMS@
@IBIAS@
Vout sweep 0 0.9
Eu ou 0 sweep 0 1
Ed od 0 sweep 0 1
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u
.end
