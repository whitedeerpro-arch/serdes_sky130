Xsn ckn vbias vss vss sky130_fd_pr__nfet_01v8 w=4 l=0.5
Xmaster qn qp mp mn ckp ckn vbias_logic vdd vss pll_cml_latch_h80_pdk
Xslave mp mn qp qn ckn ckp vbias_logic vdd vss pll_cml_latch_h80_pdk
.ends pll_cml_div2_biased_h80_pdk
