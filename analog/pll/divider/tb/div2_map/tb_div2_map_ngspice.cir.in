One CML divide-by-2 with its clock gates driven directly: feasible region against clock common mode and swing
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_div2.spice"
Vdd vdd 0 @SUPPLY@
Vref vref 0 @SUPPLY@
Iref vref vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
Xlb vbias vbias_logic vdd 0 pll_cml_tail_bias
Vcm vcm 0 1
Va va 0 0.05
Bp ckp 0 V=v(vcm)+v(va)*sin(@W@*time)
Bn ckn 0 V=v(vcm)-v(va)*sin(@W@*time)
Xmaster qn qp mp mn ckp ckn vbias_logic vdd 0 pll_cml_latch @LATCH@
Xslave mp mn qp qn ckn ckp vbias_logic vdd 0 pll_cml_latch @LATCH@
@LOAD@
Ikick qp qn PWL(0 1u 20p 1u 21p 0)
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(qp) v(qn) v(mp) v(mn) v(xmaster.tail) v(vbias_logic) v(vbias)
+ @m.xmaster.xtail.xmos.msky130_fd_pr__nfet_01v8[id]
+ @m.xmaster.xtail.xmos.msky130_fd_pr__nfet_01v8[vdsat]
+ @m.xmaster.xct.xmos.msky130_fd_pr__nfet_01v8_lvt[id]
+ @m.xmaster.xch.xmos.msky130_fd_pr__nfet_01v8_lvt[id]
+ @m.xmaster.xhp.xmos.msky130_fd_pr__nfet_01v8_lvt[gm]
.control
set num_threads=1
set filetype=binary
@CASES@
quit
.endc
.end
