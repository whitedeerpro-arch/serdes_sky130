SKY130 cascaded CML divider /2 /4 /8 /16
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_div2.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_binary_chain.spice"
.include "@PROJECT_ROOT@/verification/stimuli/spice/cml_diff_sine.spice"
.param supply=1.8 freq=2G vcm=1.632 vdiff_pp=0.4 iref=0.85m cload=5f
.param wsf=80 wsf_sink=4 wdata=20 whold=80 wclock=64 wtail=72 nftail=24 rload=600
Vdd vdd 0 {supply}
Vreference vref 0 {supply}
Iref vref vbias {iref}
Xbias vbias vbias 0 0 serdes_nfet w=20 l=0.5 nf=4
Xstim clkp clkn 0 stim_cml_diff_sine vcm={vcm} vdiff_pp={vdiff_pp} freq={freq}
Xdiv clkp clkn q2p q2n q4p q4n q8p q8n q16p q16n vbias vdd 0 pll_cml_binary_chain
+ wsf={wsf} wsf_sink={wsf_sink} wdata={wdata} whold={whold} wclock={wclock} wtail={wtail} nftail={nftail} rload={rload}
C2p q2p 0 {cload}
C2n q2n 0 {cload}
C4p q4p 0 {cload}
C4n q4n 0 {cload}
C8p q8p 0 {cload}
C8n q8n 0 {cload}
C16p q16p 0 {cload}
C16n q16n 0 {cload}
Ikick q2p q2n PWL(0 0 1p 0 2p 1u 20p 1u 21p 0)
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.control
set wr_singlescale
set wr_vecnames
tran 2p 64n 0 2p
let din=v(clkp)-v(clkn)
let d2=v(q2p)-v(q2n)
let d4=v(q4p)-v(q4n)
let d8=v(q8p)-v(q8n)
let d16=v(q16p)-v(q16n)
let cm2=(v(q2p)+v(q2n))/2
let cm4=(v(q4p)+v(q4n))/2
let cm8=(v(q8p)+v(q8n))/2
let cm16=(v(q16p)+v(q16n))/2
let power=-v(vdd)*i(Vdd)
wrdata waveforms.tsv din d2 d4 d8 d16 cm2 cm4 cm8 cm16 power
quit
.endc
.end
