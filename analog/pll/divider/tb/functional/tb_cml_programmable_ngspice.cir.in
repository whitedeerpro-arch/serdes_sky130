SKY130 fully CML programmable integer feedback divider
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_dff.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_logic.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_divider_programmable.spice"
.include "@PROJECT_ROOT@/verification/stimuli/spice/cml_diff_sine.spice"
.param supply=1.8 freq=2G vcm=1.632 vdiff_pp=0.4 iref=0.85m cload=5f
.param code0=1 code1=1 code2=1 code3=0
Vdd vdd 0 {supply}
Vreference vref 0 {supply}
Iref vref vbias {iref}
Xbias vbias vbias 0 0 serdes_nfet w=20 l=0.5 nf=4
Xstim clkp clkn 0 stim_cml_diff_sine vcm={vcm} vdiff_pp={vdiff_pp} freq={freq}
Vn0 n0 0 {code0*supply}
Vnb0 nb0 0 {(1-code0)*supply}
Vn1 n1 0 {code1*supply}
Vnb1 nb1 0 {(1-code1)*supply}
Vn2 n2 0 {code2*supply}
Vnb2 nb2 0 {(1-code2)*supply}
Vn3 n3 0 {code3*supply}
Vnb3 nb3 0 {(1-code3)*supply}
Xdiv clkp clkn qp qn n0 nb0 n1 nb1 n2 nb2 n3 nb3 vbias vdd 0 pll_cml_divider_programmable
Cop qp 0 {cload}
Con qn 0 {cload}
Ikick xdiv.b0p xdiv.b0n PWL(0 0 1p 0 2p 1u 20p 1u 21p 0)
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.control
set wr_singlescale
set wr_vecnames
tran 2p 40n 0 2p
let din=v(clkp)-v(clkn)
let dout=v(qp)-v(qn)
let cmout=(v(qp)+v(qn))/2
let power=-v(vdd)*i(Vdd)
let bit0=v(xdiv.b0p)-v(xdiv.b0n)
let bit1=v(xdiv.b1p)-v(xdiv.b1n)
let bit2=v(xdiv.b2p)-v(xdiv.b2n)
let bit3=v(xdiv.b3p)-v(xdiv.b3n)
let zero=v(xdiv.zp)-v(xdiv.zn)
wrdata waveforms.tsv din dout cmout power bit0 bit1 bit2 bit3 zero
quit
.endc
.end
