SKY130 static CMOS programmable backend M=1..16
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cmos_divider_programmable.spice"
.param supply=1.8 input_period=4n edge_time=40p reset_release=1n cload=20f
.param code0=1 code1=1 code2=0 code3=0
Vdd vdd 0 {supply}
Vclk clk 0 PULSE(0 {supply} 2n {edge_time} {edge_time} {input_period/2-edge_time} {input_period})
Vreset rst_b 0 PWL(0 0 {reset_release} 0 {reset_release+20p} {supply})
Vm0 m0 0 {code0*supply}
Vm1 m1 0 {code1*supply}
Vm2 m2 0 {code2*supply}
Vm3 m3 0 {code3*supply}
Xdiv clk rst_b m0 m1 m2 m3 tick clk_out vdd 0 pll_cmos_divider
Ctick tick 0 {cload}
Cclk clk_out 0 {cload}
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.control
set wr_singlescale
set wr_vecnames
tran 10p 128n 0 10p
let power=-v(vdd)*i(Vdd)
wrdata waveforms.tsv v(clk) v(tick) v(clk_out) power v(xdiv.q0) v(xdiv.q1) v(xdiv.q2) v(xdiv.q3) v(xdiv.core_clk) v(rst_b)
quit
.endc
.end
