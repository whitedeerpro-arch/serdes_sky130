SKY130 CMOS divider combinational truth table: 16 codes x 16 states
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cmos_divider_programmable.spice"
.param supply=1.8
Vdd vdd 0 {supply}
Vcase case 0 0.5
Bq0 q0 0 V={supply*(floor(v(case)/1)-2*floor(v(case)/2))}
Bq1 q1 0 V={supply*(floor(v(case)/2)-2*floor(v(case)/4))}
Bq2 q2 0 V={supply*(floor(v(case)/4)-2*floor(v(case)/8))}
Bq3 q3 0 V={supply*(floor(v(case)/8)-2*floor(v(case)/16))}
Bm0 m0 0 V={supply*(floor(v(case)/16)-2*floor(v(case)/32))}
Bm1 m1 0 V={supply*(floor(v(case)/32)-2*floor(v(case)/64))}
Bm2 m2 0 V={supply*(floor(v(case)/64)-2*floor(v(case)/128))}
Bm3 m3 0 V={supply*(floor(v(case)/128)-2*floor(v(case)/256))}
Xlogic q0 q1 q2 q3 m0 m1 m2 m3 d0 d1 d2 d3 zero half vdd 0 pll_cmos_divider_next
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu itl1=1000 itl2=1000 rshunt=1e10
.control
set wr_singlescale
set wr_vecnames
dc Vcase 0.5 255.5 1
wrdata truth.tsv v(q0) v(q1) v(q2) v(q3) v(m0) v(m1) v(m2) v(m3) v(d0) v(d1) v(d2) v(d3) v(zero) v(half)
quit
.endc
.end
