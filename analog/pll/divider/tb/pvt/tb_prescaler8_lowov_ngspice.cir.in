Low-overdrive CML prescaler: loaded standardized input PVT boundary
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos.spice"
.include "@PROJECT_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos_pvt_candidate.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_div2.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_prescaler8.spice"
.param supply=@SUPPLY@ freq=@FREQ_HZ@ input_pp=.3
Vdd vdd 0 {supply}
Vreference vref 0 {supply}
Iref vref vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
Vp sp 0 SIN({supply-.15} {input_pp/4} {freq})
Vn sn 0 SIN({supply-.15} {-input_pp/4} {freq})
Xbuf sp sn bp bn vbias vdd 0 serdes_cml_buffer
Xrx bp bn cm0p cm0n vbias vdd 0 serdes_cml_to_cmos_pvt_candidate
Ccm0p cm0p 0 20f
Ccm0n cm0n 0 20f
Xpre bp bn d02p d02n d04p d04n d08p d08n vbias vdd 0 pll_cml_prescaler8
C2p d02p 0 5f
C2n d02n 0 5f
C4p d04p 0 5f
C4n d04n 0 5f
C8p d08p 0 5f
C8n d08n 0 5f
Xfb d08p d08n fb0 fb0n vbias vdd 0 serdes_cml_to_cmos_pvt_candidate
Cfb0 fb0 0 20f
Cfb0n fb0n 0 20f
.nodeset v(xrx.xrestore.qp)=0 v(xrx.xrestore.qn)={supply}
.nodeset v(xfb.xrestore.qp)=0 v(xfb.xrestore.qn)={supply}
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u
.save v(vdd) i(Vdd) v(vref) i(Vreference) v(vbias) v(xpre.vbias_logic)
+ v(bp) v(bn) v(d02p) v(d02n) v(d04p) v(d04n) v(d08p) v(d08n)
+ v(fb0) v(fb0n) v(cm0p) v(cm0n) v(xpre.x2.ckp) v(xpre.x2.ckn)
+ v(xpre.x2.xmaster.tail) v(xpre.xbias.pdiode)
+ @m.xpre.x2.xmaster.xtail.xmos.msky130_fd_pr__nfet_01v8[id]
+ @m.xpre.x2.xmaster.xtail.xmos.msky130_fd_pr__nfet_01v8[vdsat]
+ @m.xpre.xbias.xref.xmos.msky130_fd_pr__nfet_01v8[id]
.control
set num_threads=1
set wr_singlescale
set wr_vecnames
tran 4p @STOP@ 0 4p
let tail_i=@m.xpre.x2.xmaster.xtail.xmos.msky130_fd_pr__nfet_01v8[id]
let tail_sat=@m.xpre.x2.xmaster.xtail.xmos.msky130_fd_pr__nfet_01v8[vdsat]
let local_i=@m.xpre.xbias.xref.xmos.msky130_fd_pr__nfet_01v8[id]
let power=-v(vdd)*i(Vdd)
let reference_power=-v(vref)*i(Vreference)
wrdata waveforms.tsv v(vbias) v(xpre.vbias_logic) v(bp) v(bn) v(d02p) v(d02n) v(d04p) v(d04n) v(d08p) v(d08n) v(fb0) v(fb0n) v(cm0p) v(cm0n) v(xpre.x2.ckp) v(xpre.x2.ckn) v(xpre.x2.xmaster.tail) tail_i tail_sat local_i v(xpre.xbias.pdiode) power reference_power
quit
.endc
.end
