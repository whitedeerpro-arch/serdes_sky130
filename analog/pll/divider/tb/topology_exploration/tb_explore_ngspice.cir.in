Exploratory latch/divider topology | @NAME@
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@SOURCE_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@SOURCE_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@SOURCE_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@SOURCE_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos.spice"
.include "@SOURCE_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos_pvt_candidate.spice"
.include "@SOURCE_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@SOURCE_ROOT@/analog/pll/divider/spice/cml_div2.spice"
.include "@SOURCE_ROOT@/analog/pll/divider/spice/exploratory/latch_candidates.spice"
.param supply=@SUPPLY@ freq=@FREQUENCY@ clkcm=@CLOCK_CM@ loadbias=@LOAD_BIAS@ loadcap=@LOAD_CAP@
Vcore vddcore 0 {supply}
Vinterface vddif 0 {supply}
Vreference vref 0 {supply}
Iref vref vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
Xlb vbias logicbias vref 0 pll_cml_tail_bias
Ipf pref 0 .35m
Xpref pref pref vref vref serdes_pfet w=100 l=.5 nf=20
Vcm vc 0 {clkcm}
Vload vl 0 {loadbias}
Vp sp 0 SIN({supply-.15} .075 {freq})
Vn sn 0 SIN({supply-.15} -.075 {freq})
Xbuf sp sn bp bn vbias vddif 0 serdes_cml_buffer
@CLOCK_SOURCE@
@DUT@
Cqp qp 0 {loadcap}
Cqn qn 0 {loadcap}
.save v(qp) v(qn) v(mp) v(mn) v(bp) v(bn) v(ck) v(ckn)
+ v(vddcore) i(Vcore) v(vddif) i(Vinterface) v(vref) i(Vreference) v(logicbias) v(pref)
.temp @TEMPERATURE@
.options reltol=1e-4 abstol=1p vntol=1u
.control
set num_threads=1
set wr_singlescale
set wr_vecnames
tran @STEP@ @STOP@ 0 @STEP@
let core_power=-v(vddcore)*i(Vcore)
let interface_power=-v(vddif)*i(Vinterface)
let reference_power=-v(vref)*i(Vreference)
wrdata waveforms.tsv v(qp) v(qn) v(mp) v(mn) v(bp) v(bn) v(ck) v(ckn) core_power interface_power reference_power v(logicbias) v(pref)
quit
.endc
.end
