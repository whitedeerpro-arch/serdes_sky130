Xcv06 z vdd sky130_fd_pr__cap_mim_m3_1 w={cside} l={cside}
Xcv07 z vdd sky130_fd_pr__cap_mim_m3_1 w={cside} l={cside}
Xcv08 z vdd sky130_fd_pr__cap_mim_m3_1 w={cside} l={cside}
Xcv09 z vdd sky130_fd_pr__cap_mim_m3_1 w={cside} l={cside}
Xcv10 z vdd sky130_fd_pr__cap_mim_m3_1 w={cside} l={cside}
Xcv11 z vdd sky130_fd_pr__cap_mim_m3_1 w={cside} l={cside}
Xinv pre_en pre_b vdd vss serdes_cmos_inv wn=4 wp=8
Xfast pre_ref ctrl pre_en pre_b vdd vss pll_lf_tgate_lvt wn={wn_fast} wp={wp_fast}
Xint pre_ref z pre_en pre_b vdd vss pll_lf_tgate_lvt wn={wn_int} wp={wp_int}
.ends pll_loop_filter_k4

