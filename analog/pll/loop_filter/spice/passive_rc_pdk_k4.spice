Xcv00 z vdd sky130_fd_pr__cap_mim_m3_1 w={cside} l={cside}
Xcv01 z vdd sky130_fd_pr__cap_mim_m3_1 w={cside} l={cside}
Xcv02 z vdd sky130_fd_pr__cap_mim_m3_1 w={cside} l={cside}
