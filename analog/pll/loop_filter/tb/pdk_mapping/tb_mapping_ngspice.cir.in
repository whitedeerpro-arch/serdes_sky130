PLL LF PDK mapping: geometry-fixed precision poly/MIM versus nominal ideal LF
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/pll/loop_filter/spice/passive_rc.spice"
.include "@PROJECT_ROOT@/analog/pll/loop_filter/spice/passive_rc_pdk_candidate.spice"
.param supply=@SUPPLY@ rlength=12.44 cside=22.1965
Vbias vbias 0 DC 1.4
Vrplus rp 0 DC 1.41 AC 1
Vrminus rn 0 DC 1.4
Xres rp rn 0 sky130_fd_pr__res_high_po_0p69 l={rlength}
Vcunit cu 0 DC 1.4 AC 1
Xcap cu 0 sky130_fd_pr__cap_mim_m3_1 w={cside} l={cside}
Iphysical 0 physical_in AC 1u
Iideal 0 ideal_in AC 1u
Xphysical physical_in physical 0 pll_loop_filter_pdk_candidate
Xideal ideal_in ideal 0 pll_loop_filter
Rleakp physical vbias 1T
Rleaki ideal vbias 1T
.temp @TEMP_C@
.options reltol=1e-5 abstol=1p vntol=1u
.control
set num_threads=1
set wr_singlescale
set wr_vecnames
ac dec 30 100 100Meg
wrdata ac.tsv v(physical) v(ideal) i(Vrplus) i(Vcunit)
quit
.endc
.end
