Passive LF charge response; 50 fC positive injected charge
.include "@PROJECT_ROOT@/analog/pll/loop_filter/spice/passive_rc.spice"
Xlf port ctrl 0 pll_loop_filter
Istep 0 src PWL(0 0 5n 0 5.01n 50u 6n 50u 6.01n 0)
Vsense src port 0
Rdc port 0 1T
.control
set wr_singlescale
set wr_vecnames
tran 100p 250n 0 100p
wrdata response.tsv v(ctrl) v(xlf.z) i(Vsense)
quit
.endc
.end
