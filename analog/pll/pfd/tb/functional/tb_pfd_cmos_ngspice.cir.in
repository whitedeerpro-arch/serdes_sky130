SKY130 static CMOS rising-edge PFD prototype
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/pfd/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/pfd/spice/pfd_cmos.spice"
.include "@PROJECT_ROOT@/verification/stimuli/spice/pfd_clock_pair.spice"
.param supply=1.8 ref_period=4n fb_period=4n ref_delay=2n fb_delay=2.2n
.param edge_time=30p cload=20f reset_cap=5f reset_release=1n
Vdd vdd 0 {supply}
Vreset rst_b 0 PWL(0 0 {reset_release} 0 {reset_release+20p} {supply} @RESET_SEQUENCE@)
Xstim ref fb 0 stim_pfd_clock_pair vhi={supply}
+ ref_period={ref_period} fb_period={fb_period} ref_delay={ref_delay} fb_delay={fb_delay}
+ trise={edge_time} tfall={edge_time}
Xpfd ref fb rst_b up dn vdd 0 pll_pfd reset_cap={reset_cap}
Cup up 0 {cload}
Cdn dn 0 {cload}
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.control
set wr_singlescale
set wr_vecnames
tran 1p 40n 0 1p
let power=-v(vdd)*i(Vdd)
wrdata waveforms.tsv v(ref) v(fb) v(up) v(dn) v(rst_b) v(xpfd.clear_b) v(xpfd.qu) v(xpfd.qd) power v(xpfd.xup.xcore.master_en) v(xpfd.xup.xcore.slave_en)
quit
.endc
.end
