PLL mixed-view acquisition: real PFD/CP/LF, behavioral VCO and ideal /8
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/pfd/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/pfd/spice/pfd_cmos.spice"
.include "@PROJECT_ROOT@/analog/pll/cp/spice/charge_pump.spice"
.include "@PROJECT_ROOT@/analog/pll/loop_filter/spice/passive_rc.spice"
.include "@PROJECT_ROOT@/analog/pll/vco/behavioral/vco_feedback_model.spice"
.param supply=1.8 ref_period=4n vc_init=1.18 phase_init=0.5
.param fcenter=2G kvco=485Meg ndiv=8 irefn=50u irefp=50u
Vdd vdd 0 {supply}
Vcp vcp 0 {supply}
Vbias vb 0 {supply}
In vb vbn {irefn}
Ip vbp 0 {irefp}
Xbn vbn vbn 0 0 serdes_nfet w=5 l=1
Xbp vbp vbp vb vb serdes_pfet w=20 l=1 nf=4
Vref ref 0 PULSE(0 {supply} 2n 30p 30p {ref_period/2-30p} {ref_period})
Vreset rst_b 0 PWL(0 0 1n 0 1.02n {supply})
Xpfd ref fb rst_b up dn vdd 0 pll_pfd
Xcp up dn out vbn vbp vcp 0 pll_cp
Vsense out filt 0
Xlf filt ctrl 0 pll_loop_filter
Xosc ctrl fb phase freq_ghz vdd 0 pll_vco_feedback_model
+ fcenter={fcenter} kvco={kvco} ndiv={ndiv}
Cup up 0 20f
Cdn dn 0 20f
.ic v(ctrl)={vc_init} v(xlf.z)={vc_init} v(phase)={phase_init}
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(ref) v(fb) v(up) v(dn) v(ctrl) v(phase) v(freq_ghz) v(xlf.z) i(Vsense) v(vdd) i(Vdd) v(vcp) i(Vcp)
.control
set wr_singlescale
set wr_vecnames
tran 20p 2u 0 20p
let ppfd=-v(vdd)*i(Vdd)
let pcp=-v(vcp)*i(Vcp)
wrdata waveforms.tsv v(ref) v(fb) v(up) v(dn) v(ctrl) v(phase) v(freq_ghz) i(Vsense) ppfd pcp v(xlf.z)
quit
.endc
.end
