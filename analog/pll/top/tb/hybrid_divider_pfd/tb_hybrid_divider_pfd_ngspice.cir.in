SKY130 baseline CML /8 prescaler + CMOS M divider + PFD
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_div2.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_prescaler8.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cmos_divider_programmable.spice"
.include "@PROJECT_ROOT@/analog/pll/pfd/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/pfd/spice/pfd_cmos.spice"
.include "@PROJECT_ROOT@/verification/stimuli/spice/cml_diff_sine.spice"

.param supply=1.8 freq=2G vcm=1.632 vdiff_pp=0.4 iref=0.85m cload=20f
.param input_period=4n ref_period=4n reset_release=1n
.param code0=0 code1=0 code2=0 code3=0
Vdd vcmos 0 {supply}
Vpre vpre 0 {supply}
Vrx vrx 0 {supply}
Vpfd vpfd 0 {supply}
Vreference vref 0 {supply}
Iref vref vbias {iref}
Xbias vbias vbias 0 0 serdes_nfet w=20 l=0.5 nf=4
Xstim clkp clkn 0 stim_cml_diff_sine vcm={vcm} vdiff_pp={vdiff_pp} freq={freq}
Xpre clkp clkn q2p q2n q4p q4n q8p q8n vbias vpre 0 pll_cml_prescaler8
C2p q2p 0 5f
C2n q2n 0 5f
C4p q4p 0 5f
C4n q4n 0 5f
C8p q8p 0 5f
C8n q8n 0 5f
Ikick q2p q2n PWL(0 0 1p 0 2p 1u 20p 1u 21p 0)
Xrx q8p q8n clk clk_n vbias vrx 0 serdes_cml_to_cmos
Crxp clk 0 5f
Crxn clk_n 0 20f
Vreset rst_b 0 PWL(0 0 {reset_release} 0 {reset_release+20p} {supply})
Vm0 m0 0 {code0*supply}
Vm1 m1 0 {code1*supply}
Vm2 m2 0 {code2*supply}
Vm3 m3 0 {code3*supply}
Xdiv clk rst_b m0 m1 m2 m3 tick clk_out vcmos 0 pll_cmos_divider
Ctick tick 0 {cload}
Cout clk_out 0 {cload}
Vref ref 0 PULSE(0 {supply} 2n 30p 30p {ref_period/2-30p} {ref_period})
Xpfd ref tick rst_b up dn vpfd 0 pll_pfd
Cup up 0 20f
Cdn dn 0 20f
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.control
set wr_singlescale
set wr_vecnames
tran 2p 64n 0 2p
let power=-v(vcmos)*i(Vdd)
let ppre=-v(vpre)*i(Vpre)
let prx=-v(vrx)*i(Vrx)
let ppfd=-v(vpfd)*i(Vpfd)
let d2=v(q2p)-v(q2n)
let d4=v(q4p)-v(q4n)
let d8=v(q8p)-v(q8n)
wrdata waveforms.tsv v(clk) v(tick) v(clk_out) power v(xdiv.q0) v(xdiv.q1) v(xdiv.q2) v(xdiv.q3) v(xdiv.core_clk) v(rst_b) ppre prx ppfd v(ref) v(up) v(dn) d2 d4 d8
quit
.endc
.end
