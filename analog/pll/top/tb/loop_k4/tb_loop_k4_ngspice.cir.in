PLL r5 / k=4 loop: transistor PFD, current-steering CP, PDK loop filter; behavioural VCO (working-map parabola) and /8
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_pfet_lvt.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/pfd/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/pfd/spice/pfd_cmos.spice"
.include "@PROJECT_ROOT@/analog/pll/cp/spice/charge_pump.spice"
.include "@PROJECT_ROOT@/analog/pll/cp/spice/charge_pump_steer.spice"
.include "@PROJECT_ROOT@/analog/pll/loop_filter/spice/passive_rc_precharge.spice"
.include "@PROJECT_ROOT@/analog/pll/loop_filter/spice/passive_rc_pdk_k4.spice"
.include "@PROJECT_ROOT@/analog/pll/vco/behavioral/vco_feedback_poly.spice"
.param supply=@SUPPLY@ irefn=50u irefp=50u
Vdd vdd 0 {supply}
Vbias vb 0 {supply}
In vb vbn {irefn}
Ip vbp 0 {irefp}
Xbn vbn vbn 0 0 serdes_nfet w=5 l=1
Xbp vbp vbp vb vb serdes_pfet w=20 l=1 nf=4
Ibuf vdd ibuf 10u
.include "ref.inc"
Vreset rst_b 0 PWL(0 0 1n 0 1.02n {supply})
Xpfd ref fb rst_b up dn vdd 0 pll_pfd
Xcp up dn cp vbn vbp ibuf vdd 0 pll_cp_steer @CP@
Xlf cp ctrl z pre_ref pre_en vdd 0 pll_loop_filter_k4
Vpre pre_ref 0 @VPRE@
Vpen pre_en 0 PWL(0 {supply} @TREL@ {supply} @TREL2@ 0)
Xosc ctrl fb phase f_ghz vdd 0 pll_vco_feedback_poly a0=@A0@ a1=@A1@ a2=@A2@ cload=@CLOAD@
.ic v(phase)=0.5
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(ref) v(fb) v(ctrl) v(z) v(f_ghz) v(phase)
.control
set num_threads=1
tran 5p @STOP@ 0 20p
wrdata loop.tsv v(ref) v(fb) v(ctrl) v(z) v(f_ghz)
quit
.endc
.end
