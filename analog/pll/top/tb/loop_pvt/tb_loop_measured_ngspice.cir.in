Same-corner measured VCO plant with real PFD CP LF
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@SOURCE_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@SOURCE_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@SOURCE_ROOT@/analog/common/devices/spice/cmos_dff_reset.spice"
.include "@SOURCE_ROOT@/analog/pll/pfd/spice/cmos_dff_reset.spice"
.include "@SOURCE_ROOT@/analog/pll/pfd/spice/pfd_cmos.spice"
.include "@SOURCE_ROOT@/analog/pll/cp/spice/charge_pump.spice"
.include "@SOURCE_ROOT@/analog/pll/loop_filter/spice/passive_rc.spice"
.include "@SOURCE_ROOT@/analog/pll/loop_filter/spice/passive_rc_pdk_candidate.spice"
.include "@SOURCE_ROOT@/analog/pll/vco/behavioral/measured_feedback_table.spice"
.param supply=@SUPPLY@ vc_init=@VC_INIT@
Vdd vdd 0 {supply}
Vcp vcp 0 {supply}
Vbias vb 0 {supply}
In vb vbn 50u
Ip vbp 0 50u
Xbn vbn vbn 0 0 serdes_nfet w=5 l=1
Xbp vbp vbp vb vb serdes_pfet w=20 l=1 nf=4
Vref ref 0 PULSE(0 {supply} 2n 30p 30p 1.97n 4n)
Vreset rst_b 0 PWL(0 0 1n 0 1.02n {supply})
Xpfd ref fb rst_b up dn vdd 0 pll_pfd
Xcp up dn out vbn vbp vcp 0 pll_cp
Vsense out filt 0
Xlf filt ctrl 0 @LF_SUBCKT@
Xosc ctrl fb phase freq_ghz valid vdd 0 pll_measured_feedback
+ vlo=@VLO@ vmi=@VMI@ vhi=@VHI@ flo=@FLO@ fmi=@FMI@ fhi=@FHI@ edge_shape=@EDGE_SHAPE@
Cup up 0 20f
Cdn dn 0 20f
.ic v(ctrl)={vc_init} v(xlf.z)={vc_init} v(phase)=.13
.temp @TEMPERATURE@
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(ref) v(fb) v(up) v(dn) v(ctrl) v(xlf.z) v(phase) v(freq_ghz) v(valid) i(Vsense)
+ v(vdd) i(Vdd) v(vcp) i(Vcp)
.control
set num_threads=1
set wr_singlescale
set wr_vecnames
tran 20p @STOP@ 0 20p
let pfd_power=-v(vdd)*i(Vdd)
let cp_power=-v(vcp)*i(Vcp)
wrdata waveforms.tsv v(ref) v(fb) v(up) v(dn) v(ctrl) v(xlf.z) v(phase) v(freq_ghz) v(valid) i(Vsense) pfd_power cp_power
quit
.endc
.end
