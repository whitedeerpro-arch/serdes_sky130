SKY130 real PFD and CP at a clamped control voltage
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/pfd/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/pfd/spice/pfd_cmos.spice"
.include "@PROJECT_ROOT@/analog/pll/cp/spice/charge_pump.spice"
.include "@PROJECT_ROOT@/verification/stimuli/spice/pfd_clock_pair.spice"
.param supply=1.8 ref_period=4n fb_period=4n fb_delay=2n vout_dc=1.3
.param irefn=50u irefp=50u reset_cap=5f
.param up_wn=0.5 up_wp=2 up_ln=0.88
Vdd vdd 0 {supply}
Vcp vcp 0 {supply}
Vbias vb 0 {supply}
In vb vbn {irefn}
Ip vbp 0 {irefp}
Xbn vbn vbn 0 0 serdes_nfet w=5 l=1
Xbp vbp vbp vb vb serdes_pfet w=20 l=1 nf=4
Xclks ref fb 0 stim_pfd_clock_pair vhi={supply} ref_period={ref_period} fb_period={fb_period} ref_delay=2n fb_delay={fb_delay} trise=30p tfall=30p
Vreset rst_b 0 PWL(0 0 1n 0 1.02n {supply})
Xpfd ref fb rst_b up dn vdd 0 pll_pfd reset_cap={reset_cap}
Xcp up dn out vbn vbp vcp 0 pll_cp
+ up_wn={up_wn} up_wp={up_wp} up_ln={up_ln}
Vclamp out 0 {vout_dc}
Cup up 0 20f
Cdn dn 0 20f
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.control
set wr_singlescale
set wr_vecnames
tran 2p 32n 0 2p
let ppfd=-v(vdd)*i(Vdd)
let pcp=-v(vcp)*i(Vcp)
wrdata waveforms.tsv v(ref) v(fb) v(up) v(dn) i(Vclamp) v(out) ppfd pcp v(xpfd.clear_b)
quit
.endc
.end
