PLL PVT hierarchical loop: native PFD/CP, selected LF, same-corner measured VCO fit
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/pfd/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/pll/pfd/spice/pfd_cmos.spice"
.include "@PROJECT_ROOT@/analog/pll/cp/spice/charge_pump.spice"
.include "@PROJECT_ROOT@/analog/pll/loop_filter/spice/passive_rc.spice"
.include "@PROJECT_ROOT@/analog/pll/loop_filter/spice/passive_rc_pdk_candidate.spice"
.include "@PROJECT_ROOT@/analog/pll/vco/behavioral/pvt_feedback_model.spice"
.param supply=@SUPPLY@ vc_init=@VC_INIT@ f12=@F12@ f14=@F14@ f16=@F16@
Vdd vdd 0 {supply}
Vcp vcp 0 {supply}
Vbias vb 0 {supply}
In vb vbn 50u
Ip vbp 0 50u
Xbn vbn vbn 0 0 serdes_nfet w=5 l=1
Xbp vbp vbp vb vb serdes_pfet w=20 l=1 nf=4
Vref ref 0 PULSE(0 {supply} 2n 30p 30p 1.97n 4n)
Vreset rst_b 0 PWL(0 0 1n 0 1.02n {supply})
Xpfd ref fb rst_b up dn vdd 0 pll_pfd
Xcp up dn out vbn vbp vcp 0 pll_cp
Vsense out filt 0
Xlf filt ctrl 0 @LF_SUBCKT@
Xosc ctrl fb phase freq_ghz vdd 0 pll_pvt_feedback_model f12={f12} f14={f14} f16={f16}
Cup up 0 20f
Cdn dn 0 20f
.ic v(ctrl)={vc_init} v(xlf.z)={vc_init} v(phase)=.13
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(ref) v(fb) v(up) v(dn) v(ctrl) v(xlf.z) v(phase) v(freq_ghz) i(Vsense)
.control
set num_threads=1
set wr_singlescale
set wr_vecnames
tran 20p 2u 0 20p
wrdata waveforms.tsv v(ref) v(fb) v(ctrl) v(xlf.z) v(phase) v(freq_ghz) i(Vsense)
quit
.endc
.end
