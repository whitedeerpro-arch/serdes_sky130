SKY130 VCO + four phase buffers/receivers + CML binary divider + feedback receiver
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos.spice"
.include "@PROJECT_ROOT@/analog/pll/vco/spice/cap_bank_3b.spice"
.include "@PROJECT_ROOT@/analog/pll/vco/spice/vco_ring4.spice"

.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_div2.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_binary_chain.spice"

.param supply=1.8 iref=0.85m vctrl_dc=1.412
.param code0=1 code1=1 code2=1 cwire=0.5f cload_cmos=20f
.param rx_wsf=20 rx_wsf_sink=2 rx_win=6 rx_wload=8 rx_wtail=6 rx_pre_wp=3.6
Vcore vcore 0 {supply}
Vrx vrx 0 {supply}
Vbuf vbuf 0 {supply}
Vdiv vdiv 0 {supply}
Vfb vfb 0 {supply}
Iref vcore vbias {iref}
Xbias vbias vbias 0 0 serdes_nfet w=20 l=0.5 nf=4
Vctrl vctrl 0 {vctrl_dc}
Vb0 b0 0 {code0*supply}
Vb1 b1 0 {code1*supply}
Vb2 b2 0 {code2*supply}
Xvco q0p q0n q1p q1n q2p q2n q3p q3n vctrl b0 b1 b2 vbias vcore 0
+ pll_vco_ring4 varw=15 varl=0.5 capw=2 capl=5

* Proxy input capacitors are removed. Only an explicit residual wire C remains.
Cw0p q0p 0 {cwire}
Cw0n q0n 0 {cwire}
Cw1p q1p 0 {cwire}
Cw1n q1n 0 {cwire}
Cw2p q2p 0 {cwire}
Cw2n q2n 0 {cwire}
Cw3p q3p 0 {cwire}
Cw3n q3n 0 {cwire}

* Replace with four direct receivers or four CML buffers + receivers.
Xbuf0 q0p q0n bq0p bq0n vbias vbuf 0 serdes_cml_buffer
Xrx0 bq0p bq0n ck0p ck0n vbias vrx 0 serdes_cml_to_cmos
Xbuf1 q1p q1n bq1p bq1n vbias vbuf 0 serdes_cml_buffer
Xrx1 bq1p bq1n ck1p ck1n vbias vrx 0 serdes_cml_to_cmos
Xbuf2 q2p q2n bq2p bq2n vbias vbuf 0 serdes_cml_buffer
Xrx2 bq2p bq2n ck2p ck2n vbias vrx 0 serdes_cml_to_cmos
Xbuf3 q3p q3n bq3p bq3n vbias vbuf 0 serdes_cml_buffer
Xrx3 bq3p bq3n ck3p ck3n vbias vrx 0 serdes_cml_to_cmos
Xdivider bq0p bq0n dv2p dv2n dv4p dv4n dv8p dv8n dv16p dv16n vbias vdiv 0 pll_cml_binary_chain
Xfeedback dv8p dv8n fbp fbn vbias vfb 0 serdes_cml_to_cmos
Cfbp fbp 0 20f
Cfbn fbn 0 20f
Cdiv2p dv2p 0 5f
Cdiv2n dv2n 0 5f
Cdiv4p dv4p 0 5f
Cdiv4n dv4n 0 5f
Cdiv8p dv8p 0 5f
Cdiv8n dv8n 0 5f
Cdiv16p dv16p 0 5f
Cdiv16n dv16n 0 5f

Cl0p ck0p 0 {cload_cmos}
Cl0n ck0n 0 {cload_cmos}
Cl1p ck1p 0 {cload_cmos}
Cl1n ck1n 0 {cload_cmos}
Cl2p ck2p 0 {cload_cmos}
Cl2n ck2n 0 {cload_cmos}
Cl3p ck3p 0 {cload_cmos}
Cl3n ck3n 0 {cload_cmos}
Ikick q0p q0n PWL(0 0 1000p 0 1002p 1u 1020p 1u 1021p 0)
* Finite symmetry-breaking perturbation; not a startup-yield verification.
.nodeset v(xrx0.xrestore.qp)=1.8 v(xrx0.xrestore.qn)=0
.nodeset v(xrx1.xrestore.qp)=1.8 v(xrx1.xrestore.qn)=0
.nodeset v(xrx2.xrestore.qp)=1.8 v(xrx2.xrestore.qn)=0
.nodeset v(xrx3.xrestore.qp)=1.8 v(xrx3.xrestore.qn)=0
.nodeset v(xfeedback.xrestore.qp)=1.8 v(xfeedback.xrestore.qn)=0
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.control
set wr_singlescale
set wr_vecnames
tran 1p 64n 0 1p
let d0=v(q0p)-v(q0n)
let d1=v(q1p)-v(q1n)
let d2=v(q2p)-v(q2n)
let d3=v(q3p)-v(q3n)
let cm0=(v(q0p)+v(q0n))/2
let pcore=-v(vcore)*i(Vcore)
let prx=-v(vrx)*i(Vrx)
let pbuf=-v(vbuf)*i(Vbuf)
let div2=v(dv2p)-v(dv2n)
let div4=v(dv4p)-v(dv4n)
let div8=v(dv8p)-v(dv8n)
let div16=v(dv16p)-v(dv16n)
let divin=v(bq0p)-v(bq0n)
let cmdivin=(v(bq0p)+v(bq0n))/2
let pdiv=-v(vdiv)*i(Vdiv)
let pfb=-v(vfb)*i(Vfb)
wrdata waveforms.tsv d0 d1 d2 d3 cm0 pcore prx pbuf v(ck0p) v(ck0n) v(ck1p) v(ck1n) v(ck2p) v(ck2n) v(ck3p) v(ck3n) div2 div4 div8 div16 divin cmdivin pdiv pfb v(fbp) v(fbn)
quit
.endc
.end
