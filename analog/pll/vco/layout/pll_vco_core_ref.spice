Xs14 p14 b3 vss vss sky130_fd_pr__nfet_01v8 w=2.68 l=0.15
.ends pll_vco_cap_bank
.subckt pll_vco_ring4_4b q0p q0n q1p q1n q2p q2n q3p q3n vctrl b0 b1 b2 b3 vbias vdd vss
X0 q3n q3p q0p q0n vbias vdd vss pll_vco_delay_stage
X1 q0p q0n q1p q1n vbias vdd vss pll_vco_delay_stage
X2 q1p q1n q2p q2n vbias vdd vss pll_vco_delay_stage
X3 q2p q2n q3p q3n vbias vdd vss pll_vco_delay_stage
Xv0p q0p vctrl vss pll_vco_varactor
Xv0n q0n vctrl vss pll_vco_varactor
Xv1p q1p vctrl vss pll_vco_varactor
Xv1n q1n vctrl vss pll_vco_varactor
Xv2p q2p vctrl vss pll_vco_varactor
Xv2n q2n vctrl vss pll_vco_varactor
Xv3p q3p vctrl vss pll_vco_varactor
Xv3n q3n vctrl vss pll_vco_varactor
Xc0p q0p b0 b1 b2 b3 vss pll_vco_cap_bank
Xc0n q0n b0 b1 b2 b3 vss pll_vco_cap_bank
Xc1p q1p b0 b1 b2 b3 vss pll_vco_cap_bank
Xc1n q1n b0 b1 b2 b3 vss pll_vco_cap_bank
Xc2p q2p b0 b1 b2 b3 vss pll_vco_cap_bank
Xc2n q2n b0 b1 b2 b3 vss pll_vco_cap_bank
