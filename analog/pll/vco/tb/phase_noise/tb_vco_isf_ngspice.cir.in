Phase impulse response of the r3 VCO: charge pulses at one noise site of stage 0, one every K periods
* Free-running ring at a fixed Vctrl, four buffers as in the clock front end (their outputs: 30 fF proxy
* for the receiver and prescaler).  Each pulse lands at a later phase of the cycle than the one before,
* so one transient sweeps the whole period; the ring settles between pulses.
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/pll/vco/spice/cap_bank_3b.spice"
.include "@PROJECT_ROOT@/analog/pll/vco/spice/vco_ring4_pvt_candidate.spice"
Vdd vdd 0 @SUPPLY@
Vref vref 0 @SUPPLY@
Iref vref vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
Vctrl ctrl 0 @VCTRL@
Vb0 cfg0 0 @CFG0@
Vb1 cfg1 0 @CFG1@
Vb2 cfg2 0 @CFG2@
Xvco v0p v0n v1p v1n v2p v2n v3p v3n ctrl cfg0 cfg1 cfg2 vbias vdd 0 pll_vco_ring4_pvt_candidate
Xbuf0 v0p v0n b0p b0n vbias vdd 0 serdes_cml_buffer
Xbuf1 v1p v1n b1p b1n vbias vdd 0 serdes_cml_buffer
Xbuf2 v2p v2n b2p b2n vbias vdd 0 serdes_cml_buffer
Xbuf3 v3p v3n b3p b3n vbias vdd 0 serdes_cml_buffer
Cb0p b0p 0 30f
Cb0n b0n 0 30f
Cb1p b1p 0 30f
Cb1n b1n 0 30f
Cb2p b2p 0 30f
Cb2n b2n 0 30f
Cb3p b3p 0 30f
Cb3n b3n 0 30f
Ikick v0p v0n PWL(0 1u 20p 1u 21p 0)
@INJECT@
.temp @TEMP_C@
.options reltol=1e-5 abstol=1p vntol=1u klu
.save v(v0p) v(v0n) v(xvco.x0.tail) v(ctrl) @PROBES@
.control
set num_threads=1
set filetype=binary
tran @TSTEP@ @STOP@ @SAVE_FROM@ @TSTEP@
write @OUT@ v(v0p) v(v0n) v(xvco.x0.tail) @PROBES@
quit
.endc
.end
