SKY130 four-stage differential ring VCO exploratory transient
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/pll/vco/spice/cap_bank_3b.spice"
.include "@PROJECT_ROOT@/analog/pll/vco/spice/vco_ring4.spice"

.param supply=1.8 iref=0.85m rload=400 wn=40 nfin=8
.param vctrl_dc=1.48 code0=1 code1=1 code2=1 cload=20f
.param varw=15 varl=0.5 capw=2 capl=5
Vdd vdd 0 {supply}
Vctrl vctrl 0 {vctrl_dc}
Vb0 b0 0 {code0*supply}
Vb1 b1 0 {code1*supply}
Vb2 b2 0 {code2*supply}
* Ideal external current reference into a real diode-connected mirror device.
Iref vdd vbias {iref}
Xbias vbias vbias 0 0 sky130_fd_pr__nfet_01v8 w=20 l=0.5 nf=4
+ ad=2.9 as=4.35 pd=21.16 ps=31.74
Xvco q0p q0n q1p q1n q2p q2n q3p q3n vctrl b0 b1 b2 vbias vdd 0
+ pll_vco_ring4 wn={wn} nfin={nfin} rload={rload}
+ varw={varw} varl={varl} capw={capw} capl={capl}

* Identical proxy buffer input capacitance; no actual receiver is present yet.
Cl0p q0p 0 {cload}
Cl0n q0n 0 {cload}
Cl1p q1p 0 {cload}
Cl1n q1n 0 {cload}
Cl2p q2p 0 {cload}
Cl2n q2n 0 {cload}
Cl3p q3p 0 {cload}
Cl3n q3n 0 {cload}

* Finite startup kick, removed after 21 ps. Not a periodic drive.
Ikick q0p q0n PWL(0 0 1p 0 2p 1u 20p 1u 21p 0)
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.control
set wr_singlescale
set wr_vecnames
tran 2p 30n 0 2p
let d0=v(q0p)-v(q0n)
let d1=v(q1p)-v(q1n)
let d2=v(q2p)-v(q2n)
let d3=v(q3p)-v(q3n)
let cm0=(v(q0p)+v(q0n))/2
let ptotal=-v(vdd)*i(Vdd)
wrdata waveforms.tsv d0 d1 d2 d3 cm0 ptotal v(vbias) v(q0p) v(q0n)
quit
.endc
.end
