RX CTLE saved actual-TX6dB channel record; voltage replay, not loaded-channel cosimulation
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/rx/ctle/spice/rx_ctle_rc.spice"
.include "stimuli.inc"
Vdd vdd 0 1.8
Iref vdd vbias 50u
Xref vbias vbias 0 0 serdes_nfet_lvt w=8 l=0.5 nf=4
Veq0 eq0 0 @EQ0_V@
Veq1 eq1 0 @EQ1_V@
Xeq ip in op on eq0 eq1 vbias vdd 0 serdes_rx_ctle_rc
Cop op 0 20f
Con on 0 20f
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(ip) v(in) v(op) v(on) v(vdd) i(Vdd) v(xeq.sp) v(xeq.sn)
.control
set wr_singlescale
set wr_vecnames
tran 4p 100n 0 4p
let inputdiff=v(ip)-v(in)
let outputdiff=v(op)-v(on)
let inputcm=(v(ip)+v(in))/2
let outputcm=(v(op)+v(on))/2
let pcore=-v(vdd)*i(Vdd)
wrdata waveforms.tsv inputdiff outputdiff inputcm outputcm pcore v(xeq.sp) v(xeq.sn)
quit
.endc
.end
