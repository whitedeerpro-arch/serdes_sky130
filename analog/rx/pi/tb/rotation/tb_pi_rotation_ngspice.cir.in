Full360 analog PI bank static code
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_current_unit.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_sector.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_clock_mux8.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_rotator.spice"
Vdd vdd 0 1.8
Vref vref 0 1.8
Iref vref vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
Bc0p c0p 0 V=1.65+.1*tanh(sin(12.566370614359172e9*time+0.0)/.25)
Bc0n c0n 0 V=1.65-.1*tanh(sin(12.566370614359172e9*time+0.0)/.25)
Bc1p c1p 0 V=1.65+.1*tanh(sin(12.566370614359172e9*time+0.7853981633974483)/.25)
Bc1n c1n 0 V=1.65-.1*tanh(sin(12.566370614359172e9*time+0.7853981633974483)/.25)
Bc2p c2p 0 V=1.65+.1*tanh(sin(12.566370614359172e9*time+1.5707963267948966)/.25)
Bc2n c2n 0 V=1.65-.1*tanh(sin(12.566370614359172e9*time+1.5707963267948966)/.25)
Bc3p c3p 0 V=1.65+.1*tanh(sin(12.566370614359172e9*time+2.356194490192345)/.25)
Bc3n c3n 0 V=1.65-.1*tanh(sin(12.566370614359172e9*time+2.356194490192345)/.25)
Va0 a0 0 @A0_V@
Vb0 b0 0 @B0_V@
Vf0 f0 0 @F0_V@
Va1 a1 0 @A1_V@
Vb1 b1 0 @B1_V@
Vf1 f1 0 @F1_V@
Va2 a2 0 @A2_V@
Vb2 b2 0 @B2_V@
Vf2 f2 0 @F2_V@
Va3 a3 0 @A3_V@
Vb3 b3 0 @B3_V@
Vf3 f3 0 @F3_V@
Va4 a4 0 @A4_V@
Vb4 b4 0 @B4_V@
Vf4 f4 0 @F4_V@
Va5 a5 0 @A5_V@
Vb5 b5 0 @B5_V@
Vf5 f5 0 @F5_V@
Va6 a6 0 @A6_V@
Vb6 b6 0 @B6_V@
Vf6 f6 0 @F6_V@
Va7 a7 0 @A7_V@
Vb7 b7 0 @B7_V@
Vf7 f7 0 @F7_V@
Xdut c0p c0n c1p c1n c2p c2n c3p c3n a0 a1 a2 a3 a4 a5 a6 a7 b0 b1 b2 b3 b4 b5 b6 b7 f0 f1 f2 f3 f4 f5 f6 f7 dp dn ep en vbias vdd 0 serdes_pi_rotator
Cdp dp 0 20f
Cdn dn 0 20f
Cep ep 0 20f
Cen en 0 20f
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(dp) v(dn) v(ep) v(en) v(xdut.xmix0.mp) v(xdut.xmix0.mn) v(xdut.xmix1.mp) v(xdut.xmix1.mn) i(Vdd) v(vbias)
.control
set wr_singlescale
set wr_vecnames
tran 4p 4n 0 4p
let data_clock=v(dp)-v(dn)
let edge_clock=v(ep)-v(en)
let data_cm=(v(dp)+v(dn))/2
let edge_cm=(v(ep)+v(en))/2
let data_mix=v(xdut.xmix0.mp)-v(xdut.xmix0.mn)
let edge_mix=v(xdut.xmix1.mp)-v(xdut.xmix1.mn)
let power=-1.8*i(Vdd)
wrdata waveforms.tsv data_clock edge_clock data_cm edge_cm data_mix edge_mix power v(vbias)
quit
.endc
.end
