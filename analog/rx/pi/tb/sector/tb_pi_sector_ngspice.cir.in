PI adjacent-phase sector prototype
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_current_unit.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_sector.spice"
Vdd vdd 0 1.8
Vref vref 0 1.8
Iref vref vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
Bap ap 0 V=1.65+.1*tanh(sin(12.566370614359172e9*time+0)/.25)
Ban an 0 V=1.65-.1*tanh(sin(12.566370614359172e9*time+0)/.25)
Bbp bp 0 V=1.65+.1*tanh(sin(12.566370614359172e9*time+0.7853981633974483)/.25)
Bbn bn 0 V=1.65-.1*tanh(sin(12.566370614359172e9*time+0.7853981633974483)/.25)
Vb0 b0 0 @B0_V@
Vb1 b1 0 @B1_V@
Vb2 b2 0 @B2_V@
Vb3 b3 0 @B3_V@
Vb4 b4 0 @B4_V@
Vb5 b5 0 @B5_V@
Vb6 b6 0 @B6_V@
Vb7 b7 0 @B7_V@
Xdut ap an bp bn b0 b1 b2 b3 b4 b5 b6 b7 op on vbias vdd 0 serdes_pi_sector cmix=2e-13
Cop op 0 20f
Con on 0 20f
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(ap) v(an) v(bp) v(bn) v(op) v(on) v(xdut.mp) v(xdut.mn) i(Vdd) v(vbias)
.control
set wr_singlescale
set wr_vecnames
tran 2p 5n 0 2p
let da=v(ap)-v(an)
let db=v(bp)-v(bn)
let out=v(op)-v(on)
let mix=v(xdut.mp)-v(xdut.mn)
let cmout=(v(op)+v(on))/2
let cmmix=(v(xdut.mp)+v(xdut.mn))/2
let power=-1.8*i(Vdd)
wrdata waveforms.tsv da db out mix cmout cmmix power v(vbias)
quit
.endc
.end
