Bdp dp0 0 V=1.6564+.096*tanh(sin(12.566370614359172e9*(time-1.250000000000000e-10))/.4)
Vdp dp0 dp 0
Bdn dn0 0 V=1.6564-.096*tanh(sin(12.566370614359172e9*(time-1.250000000000000e-10))/.4)
Vdn dn0 dn 0
Bep ep0 0 V=1.6564+.096*tanh(sin(12.566370614359172e9*(time-0.000000000000000e+00))/.4)
Vep ep0 ep 0
Ben en0 0 V=1.6564-.096*tanh(sin(12.566370614359172e9*(time-0.000000000000000e+00))/.4)
Ven en0 en 0
Xdut ip in dp dn ep en d0p d0n d1p d1n e0p e0n e1p e1n vbias vdd 0 serdes_rx_half_rate_samples 
Cd0p d0p 0 5f
Cd0n d0n 0 5f
Cd1p d1p 0 5f
Cd1n d1n 0 5f
Ce0p e0p 0 5f
Ce0n e0n 0 5f
Ce1p e1p 0 5f
Ce1n e1n 0 5f
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(ip) v(in) v(dp) v(dn) v(ep) v(en) v(d0p) v(d0n) v(d1p) v(d1n) v(e0p) v(e0n) v(e1p) v(e1n) v(xdut.bp) v(xdut.bn) v(xdut.cdp) v(xdut.cdn) v(xdut.cep) v(xdut.cen) i(Vdd) v(vbias) i(Vdp) i(Vep)
.control
set wr_singlescale
set wr_vecnames
tran 2p 16n 0 2p
let input=v(ip)-v(in)
let data_clock=v(dp)-v(dn)
let edge_clock=v(ep)-v(en)
let d0=v(d0p)-v(d0n)
let d1=v(d1p)-v(d1n)
let e0=v(e0p)-v(e0n)
let e1=v(e1p)-v(e1n)
let shifted_clock=v(xdut.cdp)-v(xdut.cdn)
let shifted_cm=(v(xdut.cdp)+v(xdut.cdn))/2
let input_buffer=v(xdut.bp)-v(xdut.bn)
let power=-1.8*i(Vdd)
wrdata waveforms.tsv input data_clock edge_clock d0 d1 e0 e1 shifted_clock shifted_cm input_buffer power v(vbias) i(Vdp) i(Vep)
quit
.endc
.end
