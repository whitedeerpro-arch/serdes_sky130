RX sample DFF stack window: ideal static data and clock, clock common mode swept
* Data at the sampler input-buffer output level (VDD - @IN_DROP@ V, +/-100 mV); clocks static
* +/-@CK_HALF@ V around Vck (master holding, slave tracking).  The DFF is the stock cell.
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_sample_dff.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_div2.spice"
Vdd vdd 0 @SUPPLY@
Vref vref 0 @SUPPLY@
Iref vref vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
* local low-overdrive reference (PLL r2 pll_cml_tail_bias, ~1/6 density); used when DFF_BIAS = vbias_logic
Xlb vbias vbias_logic vdd 0 pll_cml_tail_bias
Vck ck 0 1.0
Bdp dp 0 V=v(vdd)-@IN_DROP@+0.05
Bdn dn 0 V=v(vdd)-@IN_DROP@-0.05
Bcp cp 0 V=v(ck)+@CK_HALF@
Bcn cn 0 V=v(ck)-@CK_HALF@
Xd dp dn cp cn qp qn @DFF_BIAS@ vdd 0 serdes_rx_sample_dff @DFF_PARAMS@
Cqp qp 0 5f
Cqn qn 0 5f
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
@SAVES@
.control
set wr_singlescale
set wr_vecnames
@CASES@
quit
.endc
.end
