RX sampler over PVT: C2 far-end replay (BC) -> CTLE -> half-rate CML samplers clocked by the PI
* stimuli.inc: far-end voltages rxp/rxn (boundary condition rx_c2_far_*@ctle_rc).
* DUT: @DUT@
* PI anchors: ideal 2 GHz, 0/45/90/135 deg, 400 mVpp, common mode VDD - 0.15 V.
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@PROJECT_ROOT@/analog/rx/ctle/spice/rx_ctle_rc.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_current_unit.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_sector.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_clock_mux8.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_rotator.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_clock_shift.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_sample_dff.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_half_rate_samples.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_div2.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_clock_ac.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_half_rate_samples_ac.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_offset_dac.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_offset_trim.spice"
.include "stimuli.inc"
Vdd vdd 0 @SUPPLY@
Vref vref 0 @SUPPLY@
Iref vref vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
Ictle vref vctle 50u
Xcbias vctle vctle 0 0 serdes_nfet_lvt w=8 l=.5 nf=4
Veq0 eq0 0 @EQ0_V@
Veq1 eq1 0 @EQ1_V@
Xeq rxp rxn op on eq0 eq1 vctle vdd 0 serdes_rx_ctle_rc
Bc0p c0p 0 V=v(vdd)-0.15+.1*tanh(sin(12.566370614359172e9*time+0.0)/.25)
Bc0n c0n 0 V=v(vdd)-0.15-.1*tanh(sin(12.566370614359172e9*time+0.0)/.25)
Bc1p c1p 0 V=v(vdd)-0.15+.1*tanh(sin(12.566370614359172e9*time+0.7853981633974483)/.25)
Bc1n c1n 0 V=v(vdd)-0.15-.1*tanh(sin(12.566370614359172e9*time+0.7853981633974483)/.25)
Bc2p c2p 0 V=v(vdd)-0.15+.1*tanh(sin(12.566370614359172e9*time+1.5707963267948966)/.25)
Bc2n c2n 0 V=v(vdd)-0.15-.1*tanh(sin(12.566370614359172e9*time+1.5707963267948966)/.25)
Bc3p c3p 0 V=v(vdd)-0.15+.1*tanh(sin(12.566370614359172e9*time+2.356194490192345)/.25)
Bc3n c3n 0 V=v(vdd)-0.15-.1*tanh(sin(12.566370614359172e9*time+2.356194490192345)/.25)
@CONTROL_SOURCES@
Xpi c0p c0n c1p c1n c2p c2n c3p c3n a0 a1 a2 a3 a4 a5 a6 a7 b0 b1 b2 b3 b4 b5 b6 b7 f0 f1 f2 f3 f4 f5 f6 f7 dp dn ep en vbias vdd 0 serdes_pi_rotator
Xdut op on dp dn ep en d0p d0n d1p d1n e0p e0n e1p e1n vbias vdd 0 @DUT@
Cd0p d0p 0 5f
Cd0n d0n 0 5f
Cd1p d1p 0 5f
Cd1n d1n 0 5f
Ce0p e0p 0 5f
Ce0n e0n 0 5f
Ce1p e1p 0 5f
Ce1n e1n 0 5f
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(op) v(on) v(d0p) v(d0n) v(d1p) v(d1n) v(xdut.cdp) v(xdut.cdn) v(xdut.bp) v(xdut.bn) v(vdd) i(Vdd)
.control
set filetype=binary
@CASES@
quit
.endc
.end
