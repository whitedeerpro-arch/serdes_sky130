RX sampler offset / clock-phase Monte Carlo: ideal 2 GHz clocks -> serdes_rx_half_rate_samples_ac, slow input ramp
* Clocks: PI-like differential 400 mVpp at VDD - 0.15 V, D clock 0 deg, E clock 90 deg (125 ps).
* Input: CTLE-output-like common mode VDD - 0.2 V, differential ramp -25 -> +25 mV from 5 ns to 45 ns.
.lib "@MODEL_LIBRARY@" @SECTION@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_clock_shift.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_sample_dff.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_half_rate_samples.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_div2.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_clock_ac.spice"
.include "@PROJECT_ROOT@/analog/rx/sampler/spice/rx_half_rate_samples_ac.spice"
Vdd vdd 0 @SUPPLY@
Vref vref 0 @SUPPLY@
Iref vref vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
Bdp dp 0 V=v(vdd)-0.15+.1*tanh(sin(12.566370614359172e9*time)/.25)
Bdn dn 0 V=v(vdd)-0.15-.1*tanh(sin(12.566370614359172e9*time)/.25)
Bep ep 0 V=v(vdd)-0.15+.1*tanh(sin(12.566370614359172e9*time-1.5707963267948966)/.25)
Ben en 0 V=v(vdd)-0.15-.1*tanh(sin(12.566370614359172e9*time-1.5707963267948966)/.25)
Vramp ramp 0 PWL(0 -0.025 5n -0.025 45n 0.025)
Bip ip 0 V=v(vdd)-0.2+v(ramp)/2
Bin in 0 V=v(vdd)-0.2-v(ramp)/2
Xdut ip in dp dn ep en d0p d0n d1p d1n e0p e0n e1p e1n vbias vdd 0 serdes_rx_half_rate_samples_ac rb=2k
Cd0p d0p 0 5f
Cd0n d0n 0 5f
Cd1p d1p 0 5f
Cd1n d1n 0 5f
Ce0p e0p 0 5f
Ce0n e0n 0 5f
Ce1p e1p 0 5f
Ce1n e1n 0 5f
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
