.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_current_unit.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_sector.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_clock_mux8.spice"
.include "@PROJECT_ROOT@/analog/rx/pi/spice/pi_rotator.spice"
.include "@PROJECT_ROOT@/analog/rx/ctle/spice/rx_ctle_rc.spice"
Ictle vref vctle 50u
Xcbias vctle vctle 0 0 serdes_nfet_lvt w=8 l=.5 nf=4
Veq eq 0 1.8
Xctle xp xn ip in eq eq vctle vdd 0 serdes_rx_ctle_rc
Xctle_ref xp xn rp rn eq eq vctle vdd 0 serdes_rx_ctle_rc
Crp rp 0 20f
Crn rn 0 20f
Bc0p c0p 0 V=1.65+.1*tanh(sin(12.566370614359172e9*time+0.0)/.25)
Bc0n c0n 0 V=1.65-.1*tanh(sin(12.566370614359172e9*time+0.0)/.25)
Bc1p c1p 0 V=1.65+.1*tanh(sin(12.566370614359172e9*time+0.7853981633974483)/.25)
Bc1n c1n 0 V=1.65-.1*tanh(sin(12.566370614359172e9*time+0.7853981633974483)/.25)
Bc2p c2p 0 V=1.65+.1*tanh(sin(12.566370614359172e9*time+1.5707963267948966)/.25)
Bc2n c2n 0 V=1.65-.1*tanh(sin(12.566370614359172e9*time+1.5707963267948966)/.25)
Bc3p c3p 0 V=1.65+.1*tanh(sin(12.566370614359172e9*time+2.356194490192345)/.25)
Bc3n c3n 0 V=1.65-.1*tanh(sin(12.566370614359172e9*time+2.356194490192345)/.25)
Va0 a0 0 1.8
Vb0 b0 0 0
Vf0 f0 0 1.8
Va1 a1 0 0
Vb1 b1 0 1.8
Vf1 f1 0 1.8
Va2 a2 0 0
Vb2 b2 0 0
Vf2 f2 0 1.8
Va3 a3 0 0
Vb3 b3 0 0
Vf3 f3 0 1.8
Va4 a4 0 0
Vb4 b4 0 0
Vf4 f4 0 0
Va5 a5 0 0
Vb5 b5 0 0
Vf5 f5 0 0
Va6 a6 0 0
Vb6 b6 0 0
Vf6 f6 0 0
Va7 a7 0 0
Vb7 b7 0 0
Vf7 f7 0 0
Xpi c0p c0n c1p c1n c2p c2n c3p c3n a0 a1 a2 a3 a4 a5 a6 a7 b0 b1 b2 b3 b4 b5 b6 b7 f0 f1 f2 f3 f4 f5 f6 f7 dp dn ep en vbias vdd 0 serdes_pi_rotator
Xdut ip in dp dn ep en d0p d0n d1p d1n e0p e0n e1p e1n vbias vdd 0 serdes_rx_half_rate_samples 
Cd0p d0p 0 5f
Cd0n d0n 0 5f
Cd1p d1p 0 5f
Cd1n d1n 0 5f
Ce0p e0p 0 5f
Ce0n e0n 0 5f
Ce1p e1p 0 5f
Ce1n e1n 0 5f
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(ip) v(in) v(dp) v(dn) v(ep) v(en) v(d0p) v(d0n) v(d1p) v(d1n) v(e0p) v(e0n) v(e1p) v(e1n) v(xdut.bp) v(xdut.bn) v(xdut.cdp) v(xdut.cdn) v(xdut.cep) v(xdut.cen) i(Vdd) v(vbias) v(xp) v(xn) v(rp) v(rn)
.control
set wr_singlescale
set wr_vecnames
tran 2p 16n 0 2p
let input=v(ip)-v(in)
let data_clock=v(dp)-v(dn)
let edge_clock=v(ep)-v(en)
let d0=v(d0p)-v(d0n)
let d1=v(d1p)-v(d1n)
let e0=v(e0p)-v(e0n)
let e1=v(e1p)-v(e1n)
let shifted_clock=v(xdut.cdp)-v(xdut.cdn)
let shifted_cm=(v(xdut.cdp)+v(xdut.cdn))/2
let input_buffer=v(xdut.bp)-v(xdut.bn)
let ref_ctle=v(rp)-v(rn)
let ctle_input=v(xp)-v(xn)
let power=-1.8*i(Vdd)
wrdata waveforms.tsv input data_clock edge_clock d0 d1 e0 e1 shifted_clock shifted_cm input_buffer power v(vbias) ctle_input ref_ctle
quit
.endc
.end
