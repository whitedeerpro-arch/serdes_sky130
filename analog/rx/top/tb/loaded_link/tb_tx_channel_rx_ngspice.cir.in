Reduced actual-TX-driver / PCB / RX co-simulation: @CASE_ID@
* Saved voltages drive BEFORE TX's real input isolation buffer.
* Do not drive TX pad or RX pins with an ideal replay source.
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/tx/output_driver/spice/cml_line_driver.spice"
.include "@PROJECT_ROOT@/verification/models/channel/pcb_family/pcb_foster_cells.spice"
.include "@PROJECT_ROOT@/verification/models/channel/pcb_family/C2_loss6.spice"
.include "@PROJECT_ROOT@/analog/rx/input/spice/rx_input_termination.spice"
.include "@PROJECT_ROOT@/analog/rx/ctle/spice/rx_ctle_rc.spice"
.include "stimuli.inc"
Vbias vref_tx 0 1.8
Iref_tx vref_tx vbias_tx 0.85m
Xbias_tx vbias_tx vbias_tx 0 0 serdes_nfet w=20 l=0.5 nf=4
Vpre vdd_pre 0 1.8
Vout vdd_out 0 1.8
Venable tx_en 0 PWL(0 0 4n 0 4.1n 1.8)
Xtx tip tin tx_en txp txn vbias_tx vdd_pre vdd_out 0 serdes_tx_cml_line_driver
* The removed serializer's wire loading does not change an ideal replay source.
Cwirep tip 0 2f
Cwiren tin 0 2f
Cpadp txp 0 200f
Cpadn txn 0 200f
Rpkgp txp rpkgp .3
Rpkgn txn rpkgn .3
Lpkgp rpkgp apkgp .5n
Lpkgn rpkgn apkgn .5n
Cacp apkgp pcbp 10n
Cacn apkgn pcbn 10n
Vpcbp pcbp chip 0
Vpcbn pcbn chin 0
Xchannel chip chin farp farn 0 pcb_c2_loss6
Rwirep farp rxp .01
Rwiren farn rxn .01
Vcm vcm 0 .9
Xtermination rxp rxn vcm serdes_rx_input_termination
* One load block: proxy100fF for boundary check OR actual RX gates + residual wire.
@RX_LOAD_BLOCK@
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(tip) v(tin) v(txp) v(txn) v(rxp) v(rxn) v(pcbp) v(pcbn) i(Vpcbp) i(Vpcbn) v(vdd_pre) i(Vpre) v(vdd_out) i(Vout) v(vref_tx) i(Vbias) v(vbias_tx)
@RX_SAVE_BLOCK@
.control
set wr_singlescale
set wr_vecnames
tran 4p 100n 0 4p
let driver_input=v(tip)-v(tin)
let tx_diff=v(txp)-v(txn)
let rx_diff=v(rxp)-v(rxn)
let input_cm=(v(tip)+v(tin))/2
let tx_cm=(v(txp)+v(txn))/2
let rx_cm=(v(rxp)+v(rxn))/2
let pre_power=-v(vdd_pre)*i(Vpre)
let line_power=-v(vdd_out)*i(Vout)
let tx_bias_power=-v(vref_tx)*i(Vbias)
let pcb_diff=v(pcbp)-v(pcbn)
let pcb_current=(i(Vpcbp)-i(Vpcbn))/2
@RX_LET_BLOCK@
wrdata waveforms.tsv driver_input tx_diff rx_diff input_cm tx_cm rx_cm pre_power line_power tx_bias_power pcb_diff pcb_current @RX_WRITE_BLOCK@
quit
.endc
.end
