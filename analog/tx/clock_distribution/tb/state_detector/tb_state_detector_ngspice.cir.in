TX clock state detector: four r3 prescalers started in forced relative states
* Ideal 2 GHz sines 45 deg apart drive real extraction buffers and the r3
* prescalers of all four branches (as in the frontend). Divider start states
* are forced with .ic on each /2 stage; branch 0 is the reference.
* TX/PLL loads on the used taps: distribution input buffers and the feedback
* receiver.
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos.spice"
.include "@PROJECT_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos_pvt_candidate.spice"
.include "@PROJECT_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos_data.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_div2.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_prescaler8.spice"
.include "@PROJECT_ROOT@/analog/tx/clock_distribution/spice/tx_clock_retime.spice"
.include "@PROJECT_ROOT@/analog/tx/clock_distribution/spice/tx_clock_state_detector.spice"
.param supply=@SUPPLY@ freq=2e9 input_pp=.3
Vdd vdd 0 {supply}
Vreference vref 0 {supply}
Iref vref vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
Vp0 sp0 0 SIN({supply-.15} {input_pp/4} {freq} 0 0 0)
Vn0 sn0 0 SIN({supply-.15} {-input_pp/4} {freq} 0 0 0)
Vp1 sp1 0 SIN({supply-.15} {input_pp/4} {freq} 0 0 -45)
Vn1 sn1 0 SIN({supply-.15} {-input_pp/4} {freq} 0 0 -45)
Vp2 sp2 0 SIN({supply-.15} {input_pp/4} {freq} 0 0 -90)
Vn2 sn2 0 SIN({supply-.15} {-input_pp/4} {freq} 0 0 -90)
Vp3 sp3 0 SIN({supply-.15} {input_pp/4} {freq} 0 0 -135)
Vn3 sn3 0 SIN({supply-.15} {-input_pp/4} {freq} 0 0 -135)
Xb0 sp0 sn0 b0p b0n vbias vdd 0 serdes_cml_buffer
Xb1 sp1 sn1 b1p b1n vbias vdd 0 serdes_cml_buffer
Xb2 sp2 sn2 b2p b2n vbias vdd 0 serdes_cml_buffer
Xb3 sp3 sn3 b3p b3n vbias vdd 0 serdes_cml_buffer
Xpre0 b0p b0n d02p d02n d04p d04n d08p d08n vbias vdd 0 pll_cml_prescaler8
Xpre1 b1p b1n d12p d12n d14p d14n d18p d18n vbias vdd 0 pll_cml_prescaler8
Xpre2 b2p b2n d22p d22n d24p d24n d28p d28n vbias vdd 0 pll_cml_prescaler8
Xpre3 b3p b3n d32p d32n d34p d34n d38p d38n vbias vdd 0 pll_cml_prescaler8
* Loads on the taps the TX and the PLL use.
Xfb d08p d08n fb fbn vbias vdd 0 serdes_cml_to_cmos_pvt_candidate
Xl250 d08p d08n l250p l250n vbias vdd 0 serdes_cml_buffer wn=20 wt=12 rload=400
Xl500 d24p d24n l500p l500n vbias vdd 0 serdes_cml_buffer wn=20 wt=12 rload=400
Xl1g d32p d32n l1gp l1gn vbias vdd 0 serdes_cml_buffer wn=20 wt=12 rload=400
Xl2g b0n b0p l2gp l2gn vbias vdd 0 serdes_cml_buffer wn=20 wt=12 rload=400
Xdet d04p d04n d02p d02n d22p d22n d24p d24n d32p d32n sa sb sc vbias vdd 0 serdes_tx_clock_state_detector
@INITIAL_STATE@
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
.control
set num_threads=1
set wr_singlescale
set wr_vecnames
tran 2p @STOP@ 0 2p
let r4=v(d04p)-v(d04n)
let r2=v(d02p)-v(d02n)
let c24=v(d24p)-v(d24n)
let c32=v(d32p)-v(d32n)
let k24=v(xdet.xa.ckp)-v(xdet.xa.ckn)
let k32=v(xdet.xc.ckp)-v(xdet.xc.ckn)
let k22=v(xdet.xb.ckp)-v(xdet.xb.ckn)
let qa=v(xdet.ap)-v(xdet.an)
let qb=v(xdet.bp)-v(xdet.bn)
let qc=v(xdet.cp)-v(xdet.cn)
let bita=v(sa)
let bitb=v(sb)
let bitc=v(sc)
let d08=v(d08p)-v(d08n)
wrdata waveforms.tsv r4 r2 c24 c32 k24 k32 k22 qa qb qc bita bitb bitc d08
quit
.endc
.end
