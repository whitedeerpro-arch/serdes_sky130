* Prototype final-rank replay; instantiated load must match source deck.
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_pfet_lvt.spice"
.include "@PROJECT_ROOT@/analog/common/cml_mux/spice/cml_lowov_cells.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/tx/input_register/spice/final_retime_slice.spice"
.include "@PROJECT_ROOT@/analog/tx/output_driver/spice/cml_line_driver_lowvt_enable.spice"
.include "@PROJECT_ROOT@/verification/models/channel/diff_rlc16.spice"
Vap ap 0 PWL(0 0 6n 0)
Van an 0 PWL(0 0 6n 0)
Vbp bp 0 PWL(0 0 6n 0)
Vbn bn 0 PWL(0 0 6n 0)
Vsp sp 0 PWL(0 0 6n 0)
Vsn sn 0 PWL(0 0 6n 0)
Vbias vbias 0 PWL(0 0 6n 0)
Vlogic vbias_logic 0 PWL(0 0 6n 0)
Vdd vdd 0 PWL(0 0 6n 0)
Vtxen tx_en 0 @SUPPLY@
Xslice ap an bp bn sp sn qp qn vbias vbias_logic vdd 0 serdes_tx_final_retime_slice
Cqp qp 0 2f
Cqn qn 0 2f
Xdriver qp qn tx_en lqp lqn vbias vdd vdd 0 serdes_tx_cml_line_driver_lowvt_enable wgatep=32
Clpp lqp 0 200f
Clpn lqn 0 200f
Rlpp lqp llp .3
Rlpn lqn lln .3
Llpp llp lap .5n
Llpn lln lan .5n
Clacp lap ltp 10n
Clacn lan ltn 10n
Xchannel ltp ltn lxp lxn 0 serdes_diff_rlc16
Rlc0 lxp lrp .01
Rlc1 lxn lrn .01
Clc0 lrp 0 100f
Clc1 lrn 0 100f
Vlcm lcm 0 .9
Rlterm0 lrp lcm 50
Rlterm1 lrn lcm 50
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u
.save @VECTORS@
.control
set num_threads=1
set filetype=binary
@CASES@
quit
.endc
.end
