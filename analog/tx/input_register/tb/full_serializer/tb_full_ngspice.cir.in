Physical v3 distribution, capture bank and complete serializer/driver; ideal clock ports
.lib "@MODEL_LIBRARY@" @CORNER@
@INCLUDES@
@DISTRIBUTION@
Vdd vdd 0 @SUPPLY@
Iref vdd vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
@CLOCK_SOURCES@
@DATA@
Xclocks s250p s250n s500p s500n s1gp s1gn s2gp s2gn
+ c250p c250n c500p c500n c1gp c1gn c2gp c2gn vbias vdd 0 serdes_cml_clock_distribution_tx_lowov
Xtx d0 d1 d2 d3 d4 d5 d6 d7 d8 d9 d10 d11 d12 d13 d14 d15
+ c250p c250n c500p c500n c1gp c1gn c2gp c2gn qp qn vbias vdd 0 serdes_tx_capture_serializer16
@WIRE_LOADS@
Cqp qp 0 2f
Cqn qn 0 2f
Vtxen tx_en 0 PWL(0 0 4n 0 4.1n @SUPPLY@)
Xdriver qp qn tx_en lqp lqn vbias vdd vdd 0 serdes_tx_cml_line_driver_lowvt_enable wgatep=32
Clpp lqp 0 200f
Clpn lqn 0 200f
Rlpp lqp llp .3
Rlpn lqn lln .3
Llpp llp lap .5n
Llpn lln lan .5n
Clacp lap ltp 10n
Clacn lan ltn 10n
Xchannel ltp ltn lxp lxn 0 serdes_diff_rlc16
Rlc0 lxp lrp .01
Rlc1 lxn lrn .01
Clc0 lrp 0 100f
Clc1 lrn 0 100f
Vlcm lcm 0 .9
Rlterm0 lrp lcm 50
Rlterm1 lrn lcm 50
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u
.save @VECTORS@
.control
set num_threads=1
set filetype=binary
@TRAN@
write waveforms.raw @VECTORS@
quit
.endc
.end
