Loaded B launch latch with recorded bank clock and shifted recorded data
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff.spice"
.include "@PROJECT_ROOT@/analog/common/cmos_to_cml/spice/cmos_to_cml_data.spice"
.include "@PROJECT_ROOT@/analog/common/cml_mux/spice/cml_lowov_cells.spice"
.include "@PROJECT_ROOT@/analog/tx/input_register/spice/word_capture16_staggered.spice"
.include "@PROJECT_ROOT@/analog/tx/input_register/spice/launch_hold_slice.spice"
Vdd vdd 0 @SUPPLY@
Iref vdd vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
Xlogic vbias vbias_logic vdd 0 serdes_tx_logic_bias ref_scale=6
Vclk clk 0 PWL(0 0 3n 0)
Vclkb clk_b 0 PWL(0 1.8 3n 1.8)
Vdata data 0 PWL(0 0 3n 0)
Vpartner partner 0 PWL(0 0 3n 0)
Vsp sp 0 PWL(0 1.6 3n 1.6)
Vsn sn 0 PWL(0 1.4 3n 1.4)
Xslice data partner clk clk_b sp sn q cp cn zp zn vbias vbias_logic vdd 0 serdes_tx_launch_hold_slice
Cq q 0 2f
Cpartner partner 0 2f
Czp zp 0 5f
Czn zn 0 5f
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u
.save @VECTORS@
.control
set num_threads=1
set filetype=binary
@CASES@
quit
.endc
.end
