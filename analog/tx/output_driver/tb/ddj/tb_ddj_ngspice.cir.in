TX output stage alone: clean data input, the full-TX pad / package / AC coupling / RLC16 / remote termination
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_pfet_lvt.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/tx/output_driver/spice/cml_line_driver_lowvt_enable.spice"
.include "@PROJECT_ROOT@/verification/models/channel/diff_rlc16.spice"
.param supply=@SUPPLY@
Vdd vdd 0 {supply}
Vref vref 0 {supply}
Iref vref vbias 0.85m
Xbias vbias vbias 0 0 serdes_nfet w=20 l=0.5 nf=4
.include "stimuli.inc"
Ven tx_en 0 {supply}
* the serializer output node qp/qn as in the full TX: 2 fF besides the driver
Cqp qp 0 2f
Cqn qn 0 2f
Xdriver qp qn tx_en lqp lqn vbias vdd vdd 0 serdes_tx_cml_line_driver_lowvt_enable wgatep=32 @DRIVER@
Clpp lqp 0 @CPAD@
Clpn lqn 0 @CPAD@
Rlpp lqp llp .3
Rlpn lqn lln .3
Llpp llp lap @LPKG@
Llpn lln lan @LPKG@
Clacp lap ltp 10n
Clacn lan ltn 10n
Xchannel ltp ltn lxp lxn 0 serdes_diff_rlc16
Rlc0 lxp lrp .01
Rlc1 lxn lrn .01
Clc0 lrp 0 100f
Clc1 lrn 0 100f
Vlcm lcm 0 .9
Rlterm0 lrp lcm 50
Rlterm1 lrn lcm 50
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(vdd) v(qp) v(qn) v(xdriver.ip) v(xdriver.in) v(xdriver.gp) v(xdriver.gn) v(lqp) v(lqn) v(lrp) v(lrn) i(Vdd)
.control
set num_threads=1
tran 2p @STOP@ 0 2p
let input=v(qp)-v(qn)
let iso=v(xdriver.ip)-v(xdriver.in)
let pre=v(xdriver.gp)-v(xdriver.gn)
let pad=v(lqp)-v(lqn)
let remote=v(lrp)-v(lrn)
let power=-v(vdd)*i(Vdd)
wrdata waveforms.tsv input iso pre pad remote power
quit
.endc
.end
