4Gb/s CML line-driver prototype with explicit source/load termination and AC-coupled channel
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/tx/output_driver/spice/cml_line_driver_lowvt_enable.spice"
.include "@PROJECT_ROOT@/verification/models/channel/diff_rlc16.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_pfet_lvt.spice"
.param supply=@SUPPLY@ rchannel=0 cchannel=100f wtout=172
Vpre vpre 0 {supply}
Vout vout 0 {supply}
Vbias vb 0 {supply}
Iref vb vbias 0.85m
Xbias vbias vbias 0 0 serdes_nfet w=20 l=0.5 nf=4
.include "stimuli.inc"
Ven tx_en 0 PWL(0 0 4n 0 4.1n {supply})
Xd ip in tx_en qp qn vbias vpre vout 0 serdes_tx_cml_line_driver_lowvt_enable wtout={wtout} wgatep=32
* Exploratory pad/package parasitics, not extracted or ESD-qualified.
Cpp qp 0 200f
Cpn qn 0 200f
Rpp qp lp 0.3
Rpn qn ln 0.3
Lpp lp ap 0.5n
Lpn ln an 0.5n
Cacp ap tp 10n
Cacn an tn 10n
Xline tp tn xp xn 0 serdes_diff_rlc16
Rcp xp rp {0.01+rchannel}
Rcn xn rn {0.01+rchannel}
Ccp rp 0 {cchannel}
Ccn rn 0 {cchannel}
Vrx vcm 0 0.9
Rrp rp vcm 50
Rrn rn vcm 50
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(ip) v(in) v(qp) v(qn) v(rp) v(rn) v(xd.ip) v(xd.in) v(xd.gp) v(xd.gn) v(xd.tail) v(vpre) i(Vpre) v(vout) i(Vout) v(vb) i(Vbias)
.save v(vbias)
.save v(xd.vbtail) v(xd.en_b)
.control
set num_threads=1
set wr_singlescale
set wr_vecnames
tran @MAX_STEP@ @STOP@ 0 @MAX_STEP@
let input=v(ip)-v(in)
let tx=v(qp)-v(qn)
let rx=v(rp)-v(rn)
let iso=v(xd.ip)-v(xd.in)
let pre=v(xd.gp)-v(xd.gn)
let cmtx=(v(qp)+v(qn))/2
let cmrx=(v(rp)+v(rn))/2
let ppre=-v(vpre)*i(Vpre)
let pout=-v(vout)*i(Vout)
let pbias=-v(vb)*i(Vbias)
wrdata waveforms.tsv input tx rx iso pre cmtx cmrx v(xd.tail) ppre pout pbias v(vbias) v(xd.vbtail) v(xd.en_b)
quit
.endc
.end
