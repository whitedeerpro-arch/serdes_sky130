Line-driver balanced-input AC admittance
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/tx/output_driver/spice/cml_line_driver.spice"
.include "@PROJECT_ROOT@/verification/models/channel/diff_rlc16.spice"
.param supply=1.8 rchannel=0 cchannel=100f wtout=172
Vpre vpre 0 {supply}
Vout vout 0 {supply}
Vbias vb 0 {supply}
Iref vb vbias 0.85m
Xbias vbias vbias 0 0 serdes_nfet w=20 l=0.5 nf=4
Vip ip 0 DC 1.68 AC .5
Vin in 0 DC 1.68 AC .5 180
Ven tx_en 0 {supply}
Xd ip in tx_en qp qn vbias vpre vout 0 serdes_tx_cml_line_driver wtout={wtout}
* Exploratory pad/package parasitics, not extracted or ESD-qualified.
Cpp qp 0 200f
Cpn qn 0 200f
Rpp qp lp 0.3
Rpn qn ln 0.3
Lpp lp ap 0.5n
Lpn ln an 0.5n
Cacp ap tp 10n
Cacn an tn 10n
Xline tp tn xp xn 0 serdes_diff_rlc16
Rcp xp rp {0.01+rchannel}
Rcn xn rn {0.01+rchannel}
Ccp rp 0 {cchannel}
Ccn rn 0 {cchannel}
Vrx vcm 0 0.9
Rrp rp vcm 50
Rrn rn vcm 50
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(ip) v(in) v(qp) v(qn) v(rp) v(rn) v(xd.ip) v(xd.in) v(xd.gp) v(xd.gn) v(xd.tail) v(vpre) i(Vpre) v(vout) i(Vout) v(vb) i(Vbias)
.save i(Vip) i(Vin)
.control
set wr_singlescale
set wr_vecnames
ac lin 3 2G 4G
let yin=-i(Vip)/v(ip)
let gin=real(yin)
let cin=real(imag(yin)/(6.283185307179586*frequency))
let gain=v(qp,qn)/v(ip,in)
let gainmag=mag(gain)
wrdata capacitance.tsv gin cin gainmag
quit
.endc
.end
