PLL VCO waveform replay through existing extraction buffer and CML /8; no live PLL
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_delay_resistive.spice"
.include "@PROJECT_ROOT@/analog/common/cml_buffer/spice/cml_buffer.spice"
.include "@PROJECT_ROOT@/analog/common/cml_to_cmos/spice/cml_to_cmos.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_latch.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_div2.spice"
.include "@PROJECT_ROOT@/analog/pll/divider/spice/cml_prescaler8.spice"
.param supply=1.8 iref=0.85m
Vbuf vbuf 0 {supply}
Vpre vpre 0 {supply}
Vrx vrx 0 {supply}
Vfb vfb 0 {supply}
Vbias vref 0 {supply}
Iref vref vbias {iref}
Xbias vbias vbias 0 0 serdes_nfet w=20 l=0.5 nf=4
.include "stimuli.inc"
Xbuf v0p v0n b0p b0n vbias vbuf 0 serdes_cml_buffer
Xrx b0p b0n rxp rxn vbias vrx 0 serdes_cml_to_cmos
Crxp rxp 0 20f
Crxn rxn 0 20f
Xdiv b0p b0n q2p q2n q4p q4n q8p q8n vbias vpre 0 pll_cml_prescaler8
Xfb q8p q8n fbp fbn vbias vfb 0 serdes_cml_to_cmos
Cfbp fbp 0 20f
Cfbn fbn 0 20f
Cq2p q2p 0 5f
Cq2n q2n 0 5f
Cq4p q4p 0 5f
Cq4n q4n 0 5f
Cq8p q8p 0 5f
Cq8n q8n 0 5f
Ikick q2p q2n PWL(0 1u 20p 1u 21p 0)
.nodeset v(xrx.xrestore.qp)=0 v(xrx.xrestore.qn)=1.8
.nodeset v(xfb.xrestore.qp)=0 v(xfb.xrestore.qn)=1.8
.temp 27
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(v0p) v(v0n) v(b0p) v(b0n) v(q2p) v(q2n) v(q4p) v(q4n) v(q8p) v(q8n) v(vbuf) i(Vbuf) v(vpre) i(Vpre) v(vrx) i(Vrx) v(vfb) i(Vfb) v(vref) i(Vbias)
.control
set wr_singlescale
set wr_vecnames
tran 4p 320n 0 4p
let pbuf=-v(vbuf)*i(Vbuf)
let ppre=-v(vpre)*i(Vpre)
let prx=-v(vrx)*i(Vrx)
let pfb=-v(vfb)*i(Vfb)
let pbias=-v(vref)*i(Vbias)
wrdata waveforms.tsv v(v0p) v(v0n) v(b0p) v(b0n) v(q2p) v(q2n) v(q4p) v(q4n) v(q8p) v(q8n) pbuf ppre prx pfb pbias
quit
.endc
.end
