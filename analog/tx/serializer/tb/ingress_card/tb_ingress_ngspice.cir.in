TX ingress cell card: loaded CMOS capture -> actual CMOS/CML converter -> first-rank MOS input
.lib "@MODEL_LIBRARY@" @CORNER@
.include "@PROJECT_ROOT@/analog/common/devices/spice/sky130_primitives.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_logic.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff.spice"
.include "@PROJECT_ROOT@/analog/common/devices/spice/cmos_dff_reset.spice"
.include "@PROJECT_ROOT@/analog/common/cmos_to_cml/spice/cmos_to_cml_data.spice"
.include "@PROJECT_ROOT@/analog/common/cml_mux/spice/cml_lowov_cells.spice"
Vdd vdd 0 @SUPPLY@
Iref vdd vbias .85m
Xref vbias vbias 0 0 serdes_nfet w=20 l=.5 nf=4
Vclock clk_u 0 PULSE(0 1 1n 30p 30p 1.97n 4n)
Vdata d_u 0 PWL(0 0 4.005n 0 4.025n 1 8.005n 1 8.025n 0 12.005n 0 12.025n 1 16.005n 1 16.025n 0 20.005n 0 20.025n 1)
Vreset rst_u 0 PWL(0 0 .3n 0 .33n 1)
Bd d 0 V=v(vdd)*v(d_u)
Brst rst_b 0 V=v(vdd)*v(rst_u)
Bcl clk_l 0 V=v(vdd)*v(clk_u)
Bcr clk_r 0 V=v(vdd)*v(clk_u)
Xdff_l d clk_l q_l vdd 0 serdes_cmos_dff
Xdff_r d clk_r rst_b q_r vdd 0 serdes_cmos_dff_reset
Cql q_l 0 2f
Cqr q_r 0 2f
Xconv_l q_l cp_l cn_l vbias vdd 0 serdes_cmos_to_cml_data
Xconv_r q_r cp_r cn_r vbias vdd 0 serdes_cmos_to_cml_data
Xconstant 0 bp bn vbias vdd 0 serdes_cmos_to_cml_data
* Both selected and unselected first-rank input loading are exercised.
Vselect sel_u 0 -1
Bsp sp 0 V=v(vdd)-.25+.1*v(sel_u)
Bsn sn 0 V=v(vdd)-.25-.1*v(sel_u)
Xlogic vbias vbias_logic vdd 0 serdes_tx_logic_bias ref_scale=6
Xmux_l cp_l cn_l bp bn sp sn mp_l mn_l vbias vbias_logic vdd 0 serdes_cml_mux2_lowov wdata=40 wselect=96 wtail=72 nftail=24 wsf=80 rload=500
Xmux_r cp_r cn_r bp bn sp sn mp_r mn_r vbias vbias_logic vdd 0 serdes_cml_mux2_lowov wdata=40 wselect=96 wtail=72 nftail=24 wsf=80 rload=500
* First-rank output boundary is a 5 fF proxy, not a full serializer.
Cmpl mp_l 0 5f
Cmnl mn_l 0 5f
Cmpr mp_r 0 5f
Cmnr mn_r 0 5f
.nodeset v(q_l)=0 v(q_r)=0
.temp @TEMP_C@
.options reltol=1e-4 abstol=1p vntol=1u klu
.save v(d) v(clk_l) v(clk_r) v(q_l) v(q_r) v(cp_l) v(cn_l) v(cp_r) v(cn_r) v(vdd) i(Bcl) i(Bcr)
.control
set num_threads=1
set filetype=binary
@CASES@
quit
.endc
.end
