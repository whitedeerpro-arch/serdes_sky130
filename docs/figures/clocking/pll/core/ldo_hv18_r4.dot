digraph HV18_r4 {
  graph [rankdir=TB, bgcolor="#fafbfc", pad="0.3", nodesep="0.5", ranksep="0.55", label="HV18 r4: static supply configuration and separate noise paths", labelloc=t, fontsize=20, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#e5f1f5", color="#336c82", fontname="DejaVu Sans", fontsize=11, margin="0.13,0.1"];
  edge [color="#556677", fontname="DejaVu Sans", fontsize=9];
  vin [label="Vin pin\nHV mode: 3.0-3.6 V"];
  pass [label="Two 5 V native NMOS\nSeparate cascode-gate RC\n10k/50p; amplifier 1k/50p"];
  quiet [label="Quiet pin / local ~1.8 V\nOn-chip Cout 100 pF\nAdded pin capacitance needs limit"];
  pll [label="Planned PLL quiet domain\nVCO + 4 first buffers + CP/LF\nCode / precharge / returns: review", fillcolor="#f4eedc", color="#a08343"];
  host [label="Host 1.65-1.95 V\nShared BG / vgi"];
  ref [label="Reference enable gate\n1 Mohm / 16 pF\nOff: disconnect BG + discharge"];
  amp [label="HV error amplifier\nMiller 2 pF / 2k\nOff: clamp gate + mirror bias"];
  trim [label="Feedback voltage trim\n38k / (125k - code*1k)\n6 bits, calibrated once"];
  diode [label="Host PMOS current copy\nLocal CML diode\nThis path bypasses the LDO", fillcolor="#f4eedc", color="#a08343"];
  bias [label="Tail-gate filter candidate\n1 Mohm / 16 pF\n7.3-9.5 kHz in 3 AC boundaries"];
  gates [label="VCO + 4 buffer tail gates\nPLL acquisition waits for settling", fillcolor="#f4eedc", color="#a08343"];
  bypass [label="Static external-1.8 V configuration\nBoard straps Vin AND quiet to SAME rail\nenable=0; no runtime mode changes\nNo series switch or bypass voltage drop", fillcolor="#e7eedf", color="#71854c"];
  vin -> pass -> quiet -> pll;
  host -> ref [label="Vbg"]; ref -> amp;
  host -> amp [label="~10 uA copy"];
  quiet -> trim [label="feedback", constraint=false];
  trim -> amp [label="sense", constraint=false];
  amp -> pass [label="gate control", constraint=false];
  host -> diode -> bias -> gates;
  gates -> pll [style=dashed, label="bias only"];
  bypass -> vin [style=dashed, color="#71854c", constraint=false];
  bypass -> quiet [style=dashed, color="#71854c", constraint=false];
  {rank=same; vin; host; bypass;}
  {rank=same; pass; ref; diode;}
  {rank=same; quiet; amp; bias;}
  {rank=same; trim; gates;}
}
