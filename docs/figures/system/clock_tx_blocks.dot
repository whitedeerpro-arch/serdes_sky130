digraph clock_tx_blocks {
  graph [rankdir=TB, bgcolor="#fafbfc", pad=0.3, nodesep=0.5, ranksep=0.6, fontname="Noto Sans CJK SC", fontsize=20,
         labelloc=t, label="SerDes · PLL、Bias 与 TX 信号路径"];
  node [shape=box, style="rounded,filled", fillcolor="#e4f2ea", color="#3d7960", fontname="Noto Sans CJK SC", fontsize=11, margin="0.12,0.1"];
  edge [color="#526474", arrowsize=0.65, fontname="Noto Sans CJK SC", fontsize=9];
  subgraph cluster_bias {
    label="偏置与启动支撑"; color="#cbd6de"; fontsize=14;
    B01 [label="B01 / B02  带隙 → V/I → 分配\n恒 I·R，5 bit 修调\n本地偏置拷贝与去耦"];
    B03 [label="B03  RX vcm 1.05 V\nRX 端接共模缓冲"];
    B04 [label="B04  B2 预充参考\n双节点预充电压参考"];
    C09 [label="C09 / C10  启动监督 / 粗搜\nready · 粗码 · 捕获 · 锁定检测", fillcolor="#fff0d5", color="#ae7d28"];
    {rank=same; B01; B03; B04; C09;}
    B01 -> B03; B01 -> B04; B04 -> C09 [style=dashed, label="预充参考"];
  }
  subgraph cluster_pll {
    label="PLL · r6 quiet 原生闭环"; color="#cbd6de"; fontsize=14;
    REF [label="参考 250 MHz", fillcolor="white", color="#708090"];
    C06 [label="C06  PFD\n标准单元三态鉴相\n带复位延迟"];
    C07 [label="C07 / C08  CP + LF\nk4 转向 CP · 双节点预充 LF", fillcolor="#fff0d5", color="#ae7d28"];
    C01 [label="C01  r6 四级 CML 环振\n5 bit 粗调阵列与变容细调", fillcolor="#fff0d5", color="#ae7d28"];
    C02 [label="C02  r6q 相位抽出\n有效反馈支路与三路轻 dummy"];
    C03 [label="C03 / C04  ÷8 + 反馈转换\nr3 CML ÷8 · 250 MHz CMOS 反馈"];
    C05 [label="C05  独立全速候选\nr5 v6 AC 耦合转换"];
    {rank=same; REF; C06; C07; C01; C02;}
    {rank=same; C03; C05;}
    REF -> C06 -> C07 -> C01 -> C02;
    C02 -> C03 [label="2 GHz"];
    C03 -> C06 [label="250 MHz反馈", constraint=false];
    C02 -> C05 [style=dashed, label="候选夹具"];
  }
  subgraph cluster_tx {
    label="TX · v3 选择时钟、16:1 串化与差分驱动"; color="#cbd6de"; fontsize=14;
    T01 [label="T01  完整字捕获＋两组8位保持\n16 位并行字 · guard / blank", fillcolor="#fff0d5", color="#ae7d28"];
    T02 [label="T02  选择时钟\nv3 同步计数器与 extra5 缓冲", fillcolor="#fff0d5", color="#ae7d28"];
    T03 [label="T03  16:1 CML 串化\n电平转换 · MUX 树 · 末级重定时", fillcolor="#e5eefb", color="#527ba0"];
    T04 [label="T04  预驱与线驱动\n电流舵输出与使能", fillcolor="#e5eefb", color="#527ba0"];
    X01 [label="X01  AC / pad / PCB\n100 Ω 差分链路 · C2 模型", fillcolor="white", color="#708090"];
    {rank=same; T01; T03; T04; X01;}
    T01 -> T03 [label="两组 8 位字"];
    T02 -> T01 [label="250 MHz字时钟"];
    T02 -> T03 [label="250M / 500M / 1G / 2G"];
    T03 -> T04 -> X01;
  }
  B01 -> C01 [color="#8f68a9", style=dotted, label="模块电流拷贝", constraint=false];
  B04 -> C07 [color="#8f68a9", style=dotted, label="预充", constraint=false];
  C09 -> C06 [style=dashed, label="启动控制接口", constraint=false];
  C02 -> T02 [style=dashed, label="2 GHz · 动态同 deck 待验", constraint=false];
  B04 -> C07 [style=invis, weight=100];
  C03 -> T02 [style=invis, weight=100];
}
