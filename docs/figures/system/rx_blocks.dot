digraph rx_blocks {
  graph [rankdir=TB, bgcolor="#fafbfc", pad=0.3, nodesep=0.65, ranksep=0.65, fontname="Noto Sans CJK SC", fontsize=20,
         labelloc=t, label="SerDes · RX 采样、校准与字时钟域"];
  node [shape=box, style="rounded,filled", fillcolor="#e4f2ea", color="#3d7960", fontname="Noto Sans CJK SC", fontsize=11, margin="0.12,0.1"];
  edge [color="#526474", arrowsize=0.65, fontname="Noto Sans CJK SC", fontsize=9];
  INPUT [label="C2 PCB / 远端边界回放\n设计信道与差分 NRZ", fillcolor="white", color="#708090"];
  ANCHOR [label="C02 原生四对八相\n回归采用理想相关锚点", fillcolor="#fff0d5", color="#ae7d28"];
  BIAS [label="B02 / B03 偏置与vcm\nCTLE 电流与端接共模", fillcolor="#e5eefb", color="#527ba0"];
  R01 [label="R01  端接 + CTLE\n差分端接 · 可调增益"];
  R02 [label="R02  PI / 64码\n120 fF 混相\n数据与边沿时钟"];
  R03 [label="R03  输入buffer + 四相采样\nac_trim · c2 时钟"];
  subgraph cluster_readout {
    label="R04 · 物理解串与恢复字时钟"; color="#cbd6de"; fontsize=13;
    DIV [label="读出时钟 CML ÷2\nW40 保持支路 · 两相 1 GHz", fillcolor="#fff0d5", color="#ae7d28"];
    DEMUX [label="4路采样 → CML 1:2分路\n8路静态CML→CMOS\n匹配数据/时钟转换延迟"];
    DESER [label="CMOS 1:4 / Johnson字选通\n16 数据 + 16 边沿 + 字时钟"];
    {rank=same; DIV; DEMUX; DESER;}
    DIV -> DEMUX [label="读出时钟"];
    DEMUX -> DESER;
  }
  R06 [label="R06  映射 / 投票 / CDR / 字对齐\n恢复字时钟域", fillcolor="#e4f2ea"];
  R05 [label="R05  两边沿顺序SAR + 6bit DAC\n训练期间关闭 CDR 更新"];
  R07 [label="R07  异步 FIFO / 宿主域\nRTL 与 STA 已有\n物理 CDC 与 SS 时序待闭合", fillcolor="#eeeeee", color="#777777", style="rounded,filled,dashed"];
  {rank=same; ANCHOR; R02; BIAS;}
  {rank=same; INPUT; R01; R03; R05;}
  {rank=same; R06; R07;}
  R02 -> R01 [style=invis, weight=100];
  DEMUX -> R06 [style=invis, weight=100];
  INPUT -> R01 -> R03 [label="模拟数据"];
  ANCHOR -> R02 [style=dashed, label="待原生接入 / 当前理想源"];
  R02 -> R03 [label="D0 / E0 / D1 / E1"];
  R03 -> DEMUX [label="4路采样"];
  R03 -> DIV [label="_rk取点"];
  DESER -> R06 [label="32样本 + w"];
  R06 -> R07 [label="恢复域16位字"];
  R06 -> R02 [label="±1步 / one-hot + 温度计码", color="#8f68a9", constraint=false];
  R05 -> R03 [label="24根修调控制", color="#8f68a9", constraint=false];
  R05 -> R06 [style=dashed, label="cal_done前关闭CDR", constraint=false];
  BIAS -> R01 [style=dotted, color="#8f68a9", constraint=false];
  BIAS -> R03 [style=dotted, color="#8f68a9", constraint=false];
}
