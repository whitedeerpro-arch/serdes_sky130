digraph final_retime {
  graph [rankdir=LR, bgcolor="white", pad=.25, nodesep=.35, ranksep=.6,
    fontname="Noto Sans CJK SC", label="TX末级边界：偶/奇保持与2 GHz时钟\n首级半字A/B与这里的末级A/B不是同一分组", labelloc=t, fontsize=17];
  node [shape=box, style="rounded,filled", fillcolor="#e6f0f8", color="#567893", fontname="Noto Sans CJK SC", fontsize=11];
  edge [fontname="Noto Sans CJK SC", fontsize=9, color="#557080", arrowsize=.65];
  r2 [label="2G复制输出 r2g\n记录端口 rp / rn",fillcolor="#fff1d8",color="#b58a41"];
  iso [label="iso2g\nW24 / tail16 / R400"];
  mid [label="中间缓冲\n原1级 → 候选3级\n每级W24 / tail16 / R400",fillcolor="#fff1d8",color="#b58a41"];
  out [label="out2g\nW32 / tail24 / R300"];
  clock [label="c2gp / c2gn\n实际本地跟随器与选择负载"];
  da [label="g3_0：偶数位流\nbit0,2,…,14"];
  db [label="g3_1：奇数位流\nbit1,3,…,15"];
  a [label="末级保持A\n时钟高时跟踪／低时保持\nFS边界建立不足",fillcolor="#fde9e5",color="#b86255"];
  b [label="末级保持B\n时钟低时跟踪／高时保持"];
  mux [label="末级2:1选择\n低选A／高选B"];
  driver [label="实际driver + pad代理\nAC + RLC16 + 远端100Ω",fillcolor="#e6f3eb",color="#608574"];
  r2 -> iso -> mid -> out -> clock;
  da -> a -> mux;
  db -> b -> mux;
  clock -> a [label="sap / san"];
  clock -> b [label="sbn / sbp"];
  clock -> mux [label="sp / sn"];
  mux -> driver [label="qp / qn；每端2 fF"];
  {rank=same;da;db;}
  {rank=same;a;b;}
}
