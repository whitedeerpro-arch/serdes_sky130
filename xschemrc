# Project-local Xschem setup; no global installation or PDK changes.
# Xschem 2.8 evaluates rc text without Tcl's info-script pathname.
if {[info exists env(SERDES_PROJECT_ROOT)]} {
  set serdes_project_root [file normalize $env(SERDES_PROJECT_ROOT)]
} else {
  set serdes_project_root /home/host/Desktop/workspace/simple_serdes_fork1
}
set XSCHEM_LIBRARY_PATH "${serdes_project_root}/schematic_lib:/usr/share/xschem/xschem_library"
set XSCHEM_DESIGN_PATH $serdes_project_root
set netlist_type spice
set hspice_netlist 0
set color_ps 1
set line_width 1
set change_lw 0
if {[info exists env(SERDES_SCHEMATIC_GEOMETRY)]} {
  set initial_geometry $env(SERDES_SCHEMATIC_GEOMETRY)
}
set dark_colorscheme 0
set colors {
  "#ffffff" "#1d4ed8" "#94a3b8" "#334155" "#0f5132"
  "#9f1239" "#0e7490" "#9f1239" "#a16207" "#111827"
  "#6b21a8" "#166534" "#1e40af" "#854d0e" "#475569"
  "#991b1b" "#365314" "#0f766e" "#9d174d" "#6b21a8"
  "#b45309" "#3f6212"
}
if {[info exists env(SERDES_SCHEMATIC_OUTPUT)]} {
  set netlist_dir [file normalize $env(SERDES_SCHEMATIC_OUTPUT)]
} else {
  set netlist_dir [file join $serdes_project_root results schematics manual]
}
file mkdir $netlist_dir
